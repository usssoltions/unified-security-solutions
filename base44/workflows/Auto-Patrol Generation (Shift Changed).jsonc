{
  "name": "Auto-Patrol Generation (Shift Changed)",
  "description": "Event-driven (zero idle cost): fires only when a shift's start time, site, or assigned guard changes (clock-ins/status-only updates do NOT fire) \u2014 regenerates missing patrols and propagates guard reassignment.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"start_time\") != null) or (.trigger.changed_fields | index(\"site_id\") != null) or (.trigger.changed_fields | index(\"guard_id\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Shift"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_patrol_generation_shift_changed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateScheduledPatrols",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateScheduledPatrols"
  }
}