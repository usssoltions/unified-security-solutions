{
  "name": "MedicalReport",
  "type": "object",
  "description": "Medical module: Generated professional report. STRICT STATE MACHINE (enforced server-side by the medicalAccess gateway, compare-and-swap on the previous state): draft \u2192 pending_approval (clinical author) \u2192 approved (practice admin, NEVER the author \u2014 independent approval) \u2192 released (practice-admin-only share_report with recipient audit); pending_approval \u2192 draft (returned for changes, reason REQUIRED). Released/archived reports are IMMUTABLE. Every transition is recorded in transition_history (actor, timestamp, previous state, new state, reason) and in the platform audit log. Sharing is an explicit, audited, practice-admin-only decision; employer portal users see ONLY released reports for their own employer. Reception has ZERO report access; therapists act on their own sessions' reports. GATEWAY-ONLY ACCESS: direct client access is restricted to platform administration (built-in role 'admin' and admin_level 'platform') by RLS. Deletion is not offered through the gateway (clinical preservation).",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "report_number": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "assessment_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "employer_id": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "therapist_id": {
      "type": "string"
    },
    "therapist_name": {
      "type": "string"
    },
    "assessment_date": {
      "type": "string",
      "format": "date-time"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "internal_clinical",
        "employer_release",
        "patient_copy",
        "legal"
      ],
      "default": "internal_clinical"
    },
    "findings": {
      "type": "string"
    },
    "recommendations": {
      "type": "string"
    },
    "work_capacity": {
      "type": "string"
    },
    "restrictions": {
      "type": "string"
    },
    "return_to_work_recommendations": {
      "type": "string"
    },
    "accommodation_recommendations": {
      "type": "string"
    },
    "follow_up": {
      "type": "string"
    },
    "signature_data": {
      "type": "string",
      "description": "Therapist signature"
    },
    "file_url": {
      "type": "string",
      "description": "Generated PDF file URL"
    },
    "transition_history": {
      "type": "array",
      "default": [],
      "description": "Server-appended audit trail of every status transition (CAS-protected): actor id/name, timestamp, previous state, new state and reason.",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor_id": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "from_status": {
            "type": "string"
          },
          "to_status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "released",
        "archived"
      ],
      "default": "draft"
    },
    "shared_with_employer": {
      "type": "boolean",
      "default": false
    },
    "shared_at": {
      "type": "string",
      "format": "date-time"
    },
    "shared_by_id": {
      "type": "string"
    },
    "shared_by_name": {
      "type": "string"
    },
    "shared_recipient_name": {
      "type": "string"
    },
    "shared_version": {
      "type": "number",
      "default": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by_id": {
      "type": "string"
    },
    "generated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "patient_id",
    "session_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}