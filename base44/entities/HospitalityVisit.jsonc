{
  "name": "HospitalityVisit",
  "type": "object",
  "description": "GRID GATE Hospitality access-control workflow: ONE custom-category visit at a site whose Site.access_workflow = 'grid_gate_hospitality'. Activated only by the site's own access_workflow setting, never by branding. GATEWAY-ONLY ACCESS through finalizeAccessEntry (hospitality_submit / hospitality_cancel / hospitality_list / hospitality_evidence), which resolves tenant scope server-side and re-validates every requirement. DOCUMENT CAPTURE: 'Scan Vehicle Disk' then 'Licence Disk' (interpreted as the driver's licence) are captured with the existing scanner services; each capture is 'scanned' (decoded payload submitted, the identifier must be present inside it, SHA-256 fingerprint stored) or 'manual_photo' (ownership-verified document photo + typed identifier). A bare scanned flag is never accepted. STATE MACHINE: pending -> confirming (atomic conditional claim carrying a unique confirm_claim_token; stealable atomically after 2 minutes) -> confirmed (admission decision; current presence is derived from the linked AccessLog) | cancelled (reason recorded; access never granted). Evidence uris are accepted only when a server-created HospitalityEvidence ownership record matches this visit's customer, site and upload session. Direct client access restricted to platform administration.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership \u2014 server-resolved, never client-trusted."
    },
    "reseller_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "check_in",
        "contractor",
        "delivery",
        "event_visitor",
        "guest",
        "service_provider",
        "staff",
        "uber_eats_mrd",
        "uber",
        "visitor"
      ]
    },
    "workflow_id": {
      "type": "string",
      "default": "grid_gate_hospitality"
    },
    "workflow_version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirming",
        "confirmed",
        "cancelled"
      ],
      "default": "pending"
    },
    "submit_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "Idempotency token / evidence upload session for one guard flow."
    },
    "confirm_claimed_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL claim timestamp (stale after 2 minutes)."
    },
    "confirm_claim_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL unique token of the request currently holding the confirmation claim \u2014 the confirmation stamp is conditional on it."
    },
    "access_log_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Server-derived duplicate-presence key: normalised name + E.164 mobile (same-name visitors with different numbers stay distinct)."
    },
    "duplicate_of_access_log_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set when this draft was cancelled because the same person (identity_key or document) was already on site \u2014 links the canonical active entry."
    },
    "confirmation_party": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "reception",
        "relevant_department",
        null
      ],
      "description": "Who the guard confirmed with \u2014 server-derived from the category (never client-supplied)."
    },
    "guest_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "guest_surname": {
      "type": [
        "string",
        "null"
      ]
    },
    "person_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "person_phone": {
      "type": [
        "string",
        "null"
      ],
      "description": "Mobile number normalised to E.164. NOT a PDF requirement \u2014 carried over from the default workflow, awaiting customer decision."
    },
    "reception_confirmed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Confirmation with the confirmation_party. null = not applicable (e.g. Visitor who knew the room number) \u2014 never stored as a rejected confirmation."
    },
    "reception_confirmed_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "occupant_count": {
      "type": [
        "number",
        "null"
      ],
      "description": "Positive integer (agreed implementation assumption); Uber Eats / Mr D always exactly 1."
    },
    "room_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "room_number_source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "provided",
        "confirmed_by_reception",
        null
      ],
      "description": "Visitors: 'provided' = visitor knew the room (reception not required); 'confirmed_by_reception' = reception contacted to confirm the visit and obtain the room."
    },
    "firearm_declared": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "firearm_photo_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "po_invoice_available": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "po_invoice_photo_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "vehicle_photo_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "staff_declared": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "staff_declaration_photo_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "food_photo_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_person_photo_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "pedestrian_only": {
      "type": "boolean",
      "default": false,
      "description": "Uber Eats / Mr D: one pedestrian admitted; the vehicle disc is recorded on the visit but the vehicle remains outside and is never written to the AccessLog."
    },
    "vehicle_registration": {
      "type": [
        "string",
        "null"
      ],
      "description": "From the server-validated vehicle disc capture."
    },
    "vehicle_licence_disc_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "vehicle_make": {
      "type": [
        "string",
        "null"
      ]
    },
    "vehicle_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "vehicle_colour": {
      "type": [
        "string",
        "null"
      ]
    },
    "vehicle_disc_capture_method": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "scanned",
        "manual_photo",
        null
      ]
    },
    "vehicle_disc_payload_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL fingerprint of the decoded disc barcode payload."
    },
    "vehicle_disc_photo_uri": {
      "type": [
        "string",
        "null"
      ],
      "description": "Manual-capture route only: ownership-verified photo of the disc."
    },
    "driver_licence_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "From the server-validated driver's licence capture."
    },
    "driver_licence_capture_method": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "scanned",
        "manual_photo",
        null
      ]
    },
    "driver_licence_payload_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL fingerprint of the decoded licence barcode payload."
    },
    "driver_licence_photo_uri": {
      "type": [
        "string",
        "null"
      ],
      "description": "Manual-capture route only: ownership-verified photo of the licence."
    },
    "licence_holder_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sa_id_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "scan_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_document_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "sa_drivers_licence_disc",
        "passport",
        "foreign_drivers_licence",
        null
      ]
    },
    "identity_document_photo_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_document_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional typed passport / foreign licence number."
    },
    "cancel_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancelled_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cancelled_by_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancelled_by_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_by_guard_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by_guard_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_test": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "site_id",
    "category",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}