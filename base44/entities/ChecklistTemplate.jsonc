{
  "name": "ChecklistTemplate",
  "type": "object",
  "description": "Patrol checklist template (optionally linked to a specific site/checkpoint). TENANT OWNERSHIP: customer_id/reseller_id are authoritative ownership fields \u2014 every tenant-facing operation is scoped to them, so Customer A can never read, create, edit or deactivate Customer B's templates. The reseller_id branch is reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every customer's templates to every other customer under the same reseller (confirmed cross-customer defect class 2026-09-21). Customer Administrators manage their OWN customer's templates; Platform admins have platform-wide oversight.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "customer_id": {
      "type": "string",
      "description": "Authoritative tenant/customer ownership. Derived server-side-enforced from the creating admin's tenant (or the selected site's tenant) \u2014 a template never escapes its customer."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped access control."
    },
    "site_id": {
      "type": "string",
      "description": "Optional site scope; 'all' or unset = tenant-wide template."
    },
    "checkpoint_id": {
      "type": "string",
      "description": "Link to specific checkpoint"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "type": {
            "type": "string",
            "enum": [
              "checkbox",
              "text",
              "photo"
            ],
            "default": "checkbox"
          }
        }
      }
    },
    "requires_signature": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "items"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}