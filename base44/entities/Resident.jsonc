{
  "name": "Resident",
  "type": "object",
  "description": "Estate resident record (onboarding directory + profile linking). TENANT ACCESS: every tenant read/write goes through the estateAccess backend gateway, which resolves the caller's tenant scope server-side and enforces the controlled onboarding/link workflow (link_resident_user validates the linked User belongs to the SAME tenant and holds the resident role; one profile per user). Direct client access is restricted to platform admins by RLS.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "user_id": {
      "type": "string",
      "description": "Linked User ID \u2014 set ONLY through the gateway's link_resident_user action (validated same-tenant, resident role, one link per user)."
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "id_number": {
      "type": "string",
      "description": "SA ID number"
    },
    "unit_number": {
      "type": "string"
    },
    "estate_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending"
      ],
      "default": "active"
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "registration": {
            "type": "string"
          },
          "disc_url": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "profile_photo": {
      "type": "string"
    },
    "move_in_date": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "unit_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}