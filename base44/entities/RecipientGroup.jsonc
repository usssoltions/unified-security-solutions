{
  "name": "RecipientGroup",
  "type": "object",
  "description": "A named group of notification recipients (internal users and/or external recipients) for targeted report/notification distribution. Example: 'Daily Access Report' may contain a site manager, client rep, security company manager, trustee, and external email. TENANT ISOLATION: reads are customer-scoped; the reseller_id branch is reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every customer's recipient groups (member names/emails) to every other customer under the same reseller (confirmed cross-customer defect class 2026-09-21).",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_type": {
            "type": "string",
            "enum": [
              "user",
              "external_recipient"
            ]
          },
          "member_id": {
            "type": "string"
          },
          "member_name": {
            "type": "string"
          },
          "channel_preference": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "in_app",
                "push",
                "telegram"
              ]
            },
            "default": [
              "email"
            ]
          }
        }
      },
      "default": []
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "site_id": {
      "type": "string"
    },
    "enabled_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "in_app",
          "push",
          "telegram"
        ]
      },
      "default": [
        "email"
      ]
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "customer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}