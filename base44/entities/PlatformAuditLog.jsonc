{
  "name": "PlatformAuditLog",
  "type": "object",
  "description": "Platform-level audit trail for security-sensitive operations: user profile changes, permission changes, module entitlement changes, support access, configuration changes, and medical record access where required. Sensitive clinical values are NOT copied into audit logs. TENANT ISOLATION: the reseller_id read branch is reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every sibling customer's audit history (user names, IP addresses, entity references) to every user under the same reseller (confirmed cross-customer defect class 2026-09-21). Users see their own audit entries; customer branches remain customer-scoped; platform admins retain oversight.",
  "properties": {
    "event_type": {
      "type": "string",
      "description": "user.login, user.logout, user.created, user.updated, user.deleted, permission.changed, module.licensed, support.access, reseller.view_as, config.changed, patient.viewed, report.shared, etc."
    },
    "user_id": {
      "type": "string",
      "description": "User who performed the action"
    },
    "user_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "module_key": {
      "type": "string"
    },
    "entity_name": {
      "type": "string",
      "description": "Entity affected"
    },
    "entity_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "old_values": {
      "type": "string",
      "description": "JSON of previous values (sensitive values redacted)"
    },
    "new_values": {
      "type": "string",
      "description": "JSON of new values (sensitive values redacted)"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}