{
  "name": "ServiceTicket",
  "type": "object",
  "description": "Estate resident service ticket (support request). NO FINANCIAL CATEGORIES \u2014 the category list covers physical/operational/communal issues only; billing, levy, payment, invoice and every other financial label is deliberately absent and rejected server-side by the estateAccess gateway. TENANT ACCESS: every tenant read/write goes through the estateAccess backend gateway (resident self-service; manager assignment/resolution); direct client access is restricted to platform admins by RLS.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "site_id": {
      "type": "string"
    },
    "ticket_number": {
      "type": "string",
      "description": "Server-generated ticket reference (EST-<base36 timestamp>)."
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string",
      "description": "Contractor/vendor assigned to this ticket (self-service scoped server-side)."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "plumbing",
        "electrical",
        "structural",
        "landscaping",
        "security",
        "noise",
        "parking",
        "general",
        "other"
      ],
      "default": "general"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed",
        "cancelled",
        "reopened"
      ],
      "default": "open"
    },
    "stage": {
      "type": "string",
      "description": "Workflow stage (submitted, assigned, reopened, ...)."
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Evidence photo/video references."
    },
    "assigned_to": {
      "type": "string",
      "description": "Assigned manager User ID"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "contractor_status": {
      "type": "string",
      "description": "Vendor workflow status (vendor self-service, gateway-restricted)."
    },
    "contractor_notes": {
      "type": "string"
    },
    "contractor_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "materials_used": {
      "type": "string"
    },
    "outstanding_issues": {
      "type": "string"
    },
    "contractor_signature": {
      "type": "string"
    },
    "resident_rating": {
      "type": "number"
    },
    "resident_feedback": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}