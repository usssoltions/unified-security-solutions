{
  "name": "ServiceTicket",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "ticket_number": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "plumbing",
        "electrical",
        "structural",
        "landscaping",
        "security",
        "noise",
        "parking",
        "general",
        "aesthetics",
        "architectural",
        "other"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "stage": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "awaiting_resident",
        "estate_staff",
        "property_management",
        "aesthetics_committee",
        "trustees",
        "maintenance",
        "contractor",
        "returned_to_estate_manager",
        "awaiting_approval",
        "completed",
        "closed",
        "reopened"
      ],
      "default": "submitted",
      "description": "Master estate ticket stage \u2014 full lifecycle workflow"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "in_progress",
        "pending_resident",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "contractor_otp": {
      "type": "string",
      "description": "Once-off secure expiring job link OTP for contractors"
    },
    "contractor_link_expires": {
      "type": "string",
      "format": "date-time"
    },
    "contractor_status": {
      "type": "string",
      "enum": [
        "assigned",
        "accepted",
        "declined",
        "scheduled",
        "on_site",
        "in_progress",
        "waiting",
        "completed_awaiting_approval"
      ],
      "description": "Contractor portal workflow status"
    },
    "contractor_notes": {
      "type": "string"
    },
    "contractor_photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "contractor_signature": {
      "type": "string"
    },
    "materials_used": {
      "type": "string"
    },
    "outstanding_issues": {
      "type": "string"
    },
    "internal_timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "by_user_id": {
            "type": "string"
          },
          "by_user_name": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "confidential": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "default": []
    },
    "resolution_notes": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resident_rating": {
      "type": "number"
    },
    "resident_feedback": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "resident_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "data.vendor_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "data.vendor_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}