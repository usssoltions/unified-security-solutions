{
  "name": "VotingQuestion",
  "type": "object",
  "description": "Estate community voting question. SECURITY: every tenant vote flows through the castVote backend function (one vote per resident per question, server-verified) and every manager read/write goes through the estateAccess backend gateway; direct client access is restricted to platform admins by RLS.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "site_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "community",
        "maintenance",
        "security",
        "financial",
        "other"
      ],
      "default": "community"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft"
    },
    "opens_at": {
      "type": "string",
      "format": "date-time"
    },
    "closes_at": {
      "type": "string",
      "format": "date-time"
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resident_id": {
            "type": "string"
          },
          "resident_name": {
            "type": "string"
          },
          "option_id": {
            "type": "string"
          },
          "voted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "anonymous_results": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "question",
    "options",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}