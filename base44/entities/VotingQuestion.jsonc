{
  "name": "VotingQuestion",
  "type": "object",
  "description": "Estate module: Voting question/poll for resident engagement. Residents vote on estate matters. Votes are cast atomically via the `castVote` backend function to guarantee ballot integrity (dedup, open/closed enforcement). Tracks votes per option.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "yes_no",
        "single_choice",
        "multiple_choice"
      ],
      "default": "yes_no"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "votes": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    },
    "total_votes": {
      "type": "number",
      "default": 0
    },
    "voted_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "closed"
      ],
      "default": "draft"
    },
    "open_date": {
      "type": "string",
      "format": "date-time"
    },
    "close_date": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "title",
    "question_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}