{
  "name": "BlacklistEntry",
  "type": "object",
  "description": "A person or vehicle barred from entering. Matched against scans at the gate; a match blocks entry unless a supervisor overrides it.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "person",
        "vehicle"
      ]
    },
    "name": {
      "type": "string"
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "sa_id",
        "driver_licence",
        "passport",
        "vehicle_registration"
      ]
    },
    "identifier_value": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "trespassing",
        "theft",
        "vandalism",
        "assault",
        "blacklisted_by_client",
        "suspicious_activity",
        "non_payment",
        "other"
      ],
      "default": "other"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "photo_url": {
      "type": "string"
    },
    "added_by_id": {
      "type": "string"
    },
    "added_by_name": {
      "type": "string"
    },
    "deactivated_by_id": {
      "type": "string"
    },
    "deactivated_by_name": {
      "type": "string"
    },
    "deactivated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "entry_type",
    "identifier_type",
    "identifier_value",
    "reason",
    "active"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}