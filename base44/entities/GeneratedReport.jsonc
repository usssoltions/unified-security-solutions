{
  "name": "GeneratedReport",
  "type": "object",
  "description": "Generated operational report (shift-end, daily, weekly, incident summary). TENANT ISOLATION (was world-readable \u2014 read:null, fixed 2026-09-21): reads are now customer-scoped with a RESELLER-ADMIN-only reseller_id branch (admin_level 'reseller'); the report's guard and the creator always see their own records; platform admins retain oversight. New records carry customer_id/reseller_id; legacy unscoped records remain visible via own-record branches and to platform admins.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access"
    },
    "title": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "shift_end",
        "daily",
        "weekly",
        "incident_summary",
        "custom"
      ]
    },
    "template_id": {
      "type": "string"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "content": {
      "type": "string",
      "description": "Full AI-generated report content"
    },
    "summary": {
      "type": "string"
    },
    "statistics": {
      "type": "object",
      "properties": {
        "patrols_completed": {
          "type": "number"
        },
        "incidents_reported": {
          "type": "number"
        },
        "trainings_completed": {
          "type": "number"
        },
        "checkpoints_scanned": {
          "type": "number"
        },
        "alerts_responded": {
          "type": "number"
        }
      }
    },
    "ai_insights": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "report_type",
    "guard_id",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}