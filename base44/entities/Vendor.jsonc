{
  "name": "Vendor",
  "type": "object",
  "description": "Estate vendor/service provider. TENANT ACCESS: every tenant read/write goes through the estateAccess backend gateway (manager CRUD + vendor self-service scoped to the linked vendor record); direct client access is restricted to platform admins by RLS.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "user_id": {
      "type": "string",
      "description": "Linked vendor portal User ID \u2014 vendor self-service scope is resolved from this link server-side."
    },
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "restaurant",
        "shop",
        "laundry",
        "plumbing",
        "electrical",
        "landscaping",
        "cleaning",
        "security",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "rating": {
      "type": "number"
    },
    "operating_hours": {
      "type": "string"
    },
    "delivery_available": {
      "type": "boolean",
      "default": false
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "minimum_order": {
      "type": "number",
      "default": 0
    },
    "bank_account": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "category",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}