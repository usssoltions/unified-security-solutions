{
  "name": "Vendor",
  "type": "object",
  "description": "Estate vendor/service provider. TENANT ISOLATION: customer_id ownership stamped at creation; reads customer-scoped, reseller_id branch RESELLER-ADMIN-only (admin_level 'reseller').",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "user_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "restaurant",
        "shop",
        "laundry",
        "plumbing",
        "electrical",
        "landscaping",
        "cleaning",
        "security",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "rating": {
      "type": "number"
    },
    "operating_hours": {
      "type": "string"
    },
    "delivery_available": {
      "type": "boolean",
      "default": false
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "minimum_order": {
      "type": "number",
      "default": 0
    },
    "bank_account": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "category",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}