{
  "name": "Appointment",
  "type": "object",
  "description": "Medical module: Patient appointment. Supports calendar views and server-side conflict validation. Platform oversight: built-in role 'admin' (app owner) and admin_level 'platform'.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "appointment_number": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "employer_id": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "therapist_id": {
      "type": "string"
    },
    "therapist_name": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number"
    },
    "booking_source": {
      "type": "string",
      "enum": [
        "reception",
        "employer_portal",
        "self_referral",
        "phone",
        "other"
      ],
      "default": "reception"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "awaiting_confirmation",
        "confirmed",
        "scheduled",
        "arrived",
        "in_session",
        "session_completed",
        "report_pending",
        "report_completed",
        "no_show",
        "cancelled",
        "rescheduled"
      ],
      "default": "requested"
    },
    "notes": {
      "type": "string"
    },
    "referral_notes": {
      "type": "string"
    },
    "referral_document_url": {
      "type": "string"
    },
    "rescheduled_from_id": {
      "type": "string"
    },
    "reschedule_reason": {
      "type": "string"
    },
    "cancellation_reason": {
      "type": "string"
    },
    "arrival_time": {
      "type": "string",
      "format": "date-time"
    },
    "arrival_verified": {
      "type": "boolean",
      "default": false
    },
    "session_id": {
      "type": "string"
    },
    "check_in_user_id": {
      "type": "string"
    },
    "check_in_user_name": {
      "type": "string"
    },
    "reminders_sent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notifications_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "patient_id",
    "service_id",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.employer_id": "{{user.data.employer_id}}"
            },
            {
              "data.employer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.employer_id": "{{user.data.employer_id}}"
            },
            {
              "data.employer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}