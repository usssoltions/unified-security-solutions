{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "lighting",
        "locks",
        "fencing",
        "gate",
        "alarm_system",
        "camera",
        "plumbing",
        "electrical",
        "structural",
        "other"
      ]
    },
    "urgency": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "assigned",
        "accepted",
        "in_progress",
        "completed",
        "cancelled",
        "declined"
      ],
      "default": "reported"
    },
    "request_number": {
      "type": "string",
      "description": "Human-readable reference e.g. MNT-1234567890"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "badge_number": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "gps_accuracy": {
      "type": "number"
    },
    "location_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "photo",
              "video",
              "audio"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_by_name": {
      "type": "string"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_by": {
      "type": "string"
    },
    "declined_by_name": {
      "type": "string"
    },
    "decline_reason": {
      "type": "string"
    },
    "completion_notes": {
      "type": "string"
    },
    "completed_by": {
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "completion_media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false
    },
    "recommendations": {
      "type": "string"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "by_user_id": {
            "type": "string"
          },
          "by_user_name": {
            "type": "string"
          },
          "from_status": {
            "type": "string"
          },
          "to_status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "title",
    "category",
    "guard_id",
    "site_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}