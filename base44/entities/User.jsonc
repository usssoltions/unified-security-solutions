{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "admin",
        "estate_manager",
        "guard",
        "dispatcher",
        "resident",
        "vendor",
        "client",
        "platform_admin",
        "reseller_admin",
        "practice_admin",
        "therapist",
        "reception",
        "employer_user"
      ],
      "default": "resident"
    },
    "admin_level": {
      "type": "string",
      "enum": [
        "platform",
        "reseller",
        "customer",
        null
      ],
      "description": "Admin scope: platform (sees all tenants), reseller (sees own reseller's customers), customer (sees own tenant only). Null for non-admin users. Used by RLS to determine who bypasses tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ID if this user belongs to a reseller organization."
    },
    "customer_id": {
      "type": "string",
      "description": "Customer/tenant ID this user belongs to. Used for tenant isolation."
    },
    "employer_id": {
      "type": "string",
      "description": "Employer ID for employer portal users (medical module)."
    },
    "site_id": {
      "type": "string",
      "description": "Primary site ID for site-scoped users."
    },
    "module_context": {
      "type": "string",
      "enum": [
        "security",
        "estate",
        "medical",
        "platform"
      ],
      "default": "security",
      "description": "Primary module context for navigation and terminology."
    },
    "display_name": {
      "type": "string"
    },
    "badge_number": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram chat ID for this user, used by the central notification engine to deliver Telegram messages. Set by an admin or via a Telegram bot setup flow."
    },
    "unit_number": {
      "type": "string"
    },
    "security_pin": {
      "type": "string"
    },
    "is_clocked_in": {
      "type": "boolean",
      "default": false
    },
    "profile_photo": {
      "type": "string"
    },
    "push_token": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "stay_awake_enabled": {
      "type": "boolean",
      "default": false
    },
    "stay_awake_interval_minutes": {
      "type": "number",
      "default": 30
    },
    "patrol_reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "patrol_reminder_interval_minutes": {
      "type": "number",
      "default": 60
    },
    "needs_daily_report": {
      "type": "boolean",
      "default": false
    },
    "needs_start_of_shift_report": {
      "type": "boolean",
      "default": false
    },
    "custom_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "whatsapp": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "telegram_connected": {
      "type": "boolean",
      "default": false,
      "description": "Whether Telegram notifications are connected for this user."
    },
    "telegram_connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "telegram_username": {
      "type": "string",
      "description": "Telegram @username (display only, not authoritative identity)."
    },
    "telegram_first_name": {
      "type": "string"
    },
    "telegram_last_name": {
      "type": "string"
    },
    "telegram_notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "User-level toggle for Telegram delivery. When false, Telegram is skipped even if connected."
    }
  },
  "required": []
}