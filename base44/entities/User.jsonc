{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "admin",
        "estate_manager",
        "guard",
        "dispatcher",
        "resident",
        "vendor",
        "client"
      ],
      "default": "resident"
    },
    "badge_number": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "security_pin": {
      "type": "string",
      "description": "4-digit PIN used for clock-in verification."
    },
    "is_clocked_in": {
      "type": "boolean",
      "default": false
    },
    "profile_photo": {
      "type": "string"
    },
    "push_token": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "stay_awake_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the stay-awake alertness check is active for this guard."
    },
    "stay_awake_interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "Minutes between stay-awake checks."
    },
    "patrol_reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "patrol_reminder_interval_minutes": {
      "type": "number",
      "default": 60
    },
    "needs_daily_report": {
      "type": "boolean",
      "default": false
    },
    "needs_start_of_shift_report": {
      "type": "boolean",
      "default": false
    },
    "custom_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "whatsapp": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": []
}