{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "role_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "admin",
        "estate_manager",
        "guard",
        "dispatcher",
        "resident",
        "vendor",
        "client",
        "platform_admin",
        "reseller_admin",
        "practice_admin",
        "therapist",
        "reception",
        "employer_user",
        "customer_admin",
        "attendance_staff",
        "control_room_operator",
        null
      ],
      "default": "resident",
      "description": "Nullable: manageUser remove_access writes null when tenant access is removed. control_room_operator works the authorised control rooms' task queues (assign, verify, second sign-off)."
    },
    "admin_level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "platform",
        "reseller",
        "customer",
        null
      ],
      "description": "Admin scope: platform (sees all tenants), reseller (sees own reseller's customers), customer (sees own tenant only). Null for non-admin users. Used by RLS to determine who bypasses tenant isolation."
    },
    "reseller_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reseller ID if this user belongs to a reseller organization. Nullable: cleared by manageUser remove_access."
    },
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Customer/tenant ID this user belongs to. Used for tenant isolation. Nullable: cleared by manageUser remove_access."
    },
    "employer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Employer ID for employer portal users (medical module). Nullable: cleared by manageUser remove_access."
    },
    "site_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Primary site ID for site-scoped users. Nullable: cleared when set to 'All customer sites'."
    },
    "module_context": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "security",
        "estate",
        "medical",
        "platform",
        null
      ],
      "default": "security",
      "description": "Primary module context for navigation and terminology. Nullable: cleared by manageUser remove_access."
    },
    "first_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "User first name. full_name is platform-managed/read-only, so the editable name parts are stored here and in last_name; display_name (first + last) remains the canonical single name field used across the app (User Management, Scheduling, Scheduled Tasks, Reports, notifications)."
    },
    "last_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "User last name. See first_name."
    },
    "user_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active",
      "description": "Account status: stored, applied on invitation acceptance and editable by authorised admins. Login-blocking enforcement of suspended/inactive is a separate hardening \u2014 access removal today is manageUser remove_access."
    },
    "display_name": {
      "type": "string"
    },
    "badge_number": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram chat ID for this user, used by the central notification engine to deliver Telegram messages. Set by an admin or via a Telegram bot setup flow."
    },
    "unit_number": {
      "type": "string"
    },
    "security_pin": {
      "type": "string"
    },
    "is_clocked_in": {
      "type": "boolean",
      "default": false
    },
    "profile_photo": {
      "type": "string"
    },
    "push_token": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "stay_awake_enabled": {
      "type": "boolean",
      "default": false
    },
    "stay_awake_interval_minutes": {
      "type": "number",
      "default": 30
    },
    "patrol_reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "patrol_reminder_interval_minutes": {
      "type": "number",
      "default": 60
    },
    "needs_daily_report": {
      "type": "boolean",
      "default": false
    },
    "needs_start_of_shift_report": {
      "type": "boolean",
      "default": false
    },
    "custom_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "whatsapp": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "telegram_connected": {
      "type": "boolean",
      "default": false,
      "description": "Whether Telegram notifications are connected for this user."
    },
    "telegram_connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "telegram_username": {
      "type": "string",
      "description": "Telegram @username (display only, not authoritative identity)."
    },
    "telegram_first_name": {
      "type": "string"
    },
    "telegram_last_name": {
      "type": "string"
    },
    "telegram_notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "User-level toggle for Telegram delivery. When false, Telegram is skipped even if connected."
    }
  },
  "required": []
}