{
  "name": "PendingTenantScope",
  "type": "object",
  "description": "Holds tenant scoping (reseller_id / customer_id / site_id / role_type / admin_level) for an invited user whose User record does not exist yet (the invitee has not accepted the invitation). A User-create automation (applyPendingTenantScope) consumes these records when the invitee accepts and the User record is created, applying the scoping server-side. One record per email (idempotent). This is NOT a separate invitation system \u2014 the invitation itself is sent via base44.users.inviteUser; this entity only queues the tenant scoping to apply on acceptance.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Invitee email. Unique per pending scope (upsert by email)."
    },
    "role_type": {
      "type": "string"
    },
    "admin_level": {
      "type": "string",
      "enum": [
        "reseller",
        "customer",
        "platform"
      ],
      "description": "Only TENANT ADMINISTRATOR roles (customer_admin / practice_admin / estate_manager) receive 'customer'; reseller_admin receives 'reseller'. Operational roles receive NO admin level (null) \u2014 admin_level never grants user-management capability to operational users."
    },
    "reseller_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string",
      "description": "Optional site assignment for site-scoped operational roles (e.g. Security Guard assigned to a specific site). Validated at invite time to exist, be active, and belong to the invited customer \u2014 never a cross-tenant site. Applied to the invitee's User record on acceptance."
    },
    "display_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "expired"
      ],
      "default": "pending"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "failed"
      ],
      "default": "queued",
      "description": "Invitation delivery lifecycle: 'queued' the instant the pending scope is created, 'sent' once the platform invitation email has been dispatched (set by inviteTenantUser after inviteUser succeeds), 'failed' when dispatch fails (record retained so the admin can retry)."
    },
    "invited_by": {
      "type": "string"
    },
    "invited_by_name": {
      "type": "string"
    },
    "applied_user_id": {
      "type": "string",
      "description": "The User id the scoping was applied to, once accepted."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the invitation was cancelled by an admin (status is set to 'cancelled' via the scope notes; the cancellation event is audit-logged)."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "role_type",
    "admin_level",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}