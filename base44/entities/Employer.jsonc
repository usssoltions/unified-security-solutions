{
  "name": "Employer",
  "type": "object",
  "description": "Medical module: Corporate client / employer that refers employees for occupational therapy, RFA, FCE, and work-ability services. GATEWAY-ONLY ACCESS: every tenant-level read/write goes through the medicalAccess backend gateway (practice_admin manages; employer users see their OWN employer record only). Direct client access is restricted to platform administration (built-in role 'admin' and admin_level 'platform') by RLS. NO BILLING FIELDS \u2014 the application has no payment/billing functionality. Tenant-isolated by customer_id (practice).",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Medical practice/tenant ID this employer belongs to"
    },
    "reseller_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "physical_address": {
      "type": "string"
    },
    "postal_address": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "primary_contact_mobile": {
      "type": "string"
    },
    "hr_contact_name": {
      "type": "string",
      "description": "Optional HR contact person"
    },
    "hr_contact_phone": {
      "type": "string"
    },
    "hr_contact_email": {
      "type": "string"
    },
    "claim_reference_number": {
      "type": "string",
      "description": "Optional compensation/work-related claim reference (clinical/claims context \u2014 NOT a billing field)"
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "notification_preferences": {
      "type": "object",
      "description": "Configurable notification preferences: appointment_confirmations, appointment_changes, arrival, completion, report_ready, report_release \u2014 each with channel toggles"
    },
    "communication_permissions": {
      "type": "object",
      "description": "What employer may receive and through which channels"
    },
    "reporting_permissions": {
      "type": "object",
      "description": "Which report types this employer is authorised to receive"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "company_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}