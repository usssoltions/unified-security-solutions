{
  "name": "AlarmResponse",
  "type": "object",
  "description": "Alarm dispatch and guard response record. TENANT ISOLATION (was world-readable \u2014 read:null, fixed 2026-09-21): reads are now customer-scoped with a RESELLER-ADMIN-only reseller_id branch (admin_level 'reseller'); the assigned responder, the dispatching dispatcher and the creator always see their own records; platform admins retain oversight. New records carry customer_id/reseller_id (stamped at creation); legacy unscoped records remain visible only via own-record branches and to platform admins.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access"
    },
    "alarm_type": {
      "type": "string",
      "enum": [
        "burglary",
        "panic",
        "medical",
        "fire",
        "armed_robbery",
        "suspicious_activity",
        "false_alarm",
        "general"
      ],
      "description": "Type of alarm/incident"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "status": {
      "type": "string",
      "enum": [
        "dispatched",
        "acknowledged",
        "en_route",
        "arrived",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "dispatched"
    },
    "address": {
      "type": "string",
      "description": "Full address of incident"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    },
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dispatched_by": {
      "type": "string",
      "description": "Dispatcher ID"
    },
    "dispatched_by_name": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string",
      "description": "Responder guard ID"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "dispatched_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "en_route_at": {
      "type": "string",
      "format": "date-time"
    },
    "arrived_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_time_minutes": {
      "type": "number",
      "description": "Time from dispatch to arrival"
    },
    "responder_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Last known location of responder"
    },
    "distance_to_scene_km": {
      "type": "number"
    },
    "completion_report": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "actions_taken": {
          "type": "string"
        },
        "findings": {
          "type": "string"
        },
        "police_called": {
          "type": "boolean"
        },
        "police_case_number": {
          "type": "string"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "alarm_type",
    "address",
    "location",
    "dispatched_by",
    "assigned_to"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.dispatched_by": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.dispatched_by": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "data.dispatched_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}