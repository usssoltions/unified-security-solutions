{
  "name": "PatrolLog",
  "type": "object",
  "description": "Checkpoint scan log (patrol verification). TENANT ISOLATION: reads are customer-scoped; the reseller_id branch is reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every customer's patrol history (incl. GPS) to every other customer under the same reseller (confirmed cross-customer defect class 2026-09-21). Guards always see their own scans; platform admins retain oversight. Submissions flow through the checkpointSubmission gateway which stamps tenant fields server-side and is idempotent via submission_key. SUSPENSION (direct entity access): every non-admin RLS branch additionally requires data.customer_id != the caller's server-stamped User.tenant_suspended marker (set by customerAccess on suspension, cleared on reactivation) \u2014 a suspended customer's users are blocked from direct SDK reads/writes outside the checkpointSubmission gateway, with no effect on any other user (a missing/null marker never blocks).",
  "properties": {
    "demo_batch_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL demo provenance: the DEMO seed batch that created this record. Never set on live operational records."
    },
    "submission_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL idempotency key (client-generated UUID, stamped by the checkpointSubmission gateway): a retry or offline sync with the same key returns the existing record instead of creating a duplicate. Null on demo/legacy records."
    },
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "checkpoint_name": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "checklist_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the patrol checklist template completed with this checkpoint scan (null when the site has no active checklist). Full answers are stored on the linked ChecklistCompletion record."
    },
    "location": {
      "type": "object",
      "description": "The guard's scan GPS position at checkpoint verification.",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "checkpoint_location": {
      "type": "object",
      "description": "The checkpoint's configured GPS position this scan was verified against (present when the checkpoint has GPS).",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "distance_metres": {
      "type": "number",
      "description": "Meaningful distance between the checkpoint GPS and the scan GPS. Null when GPS was unavailable for either side."
    },
    "gps_status": {
      "type": "string",
      "enum": [
        "verified",
        "not_verified",
        "unavailable"
      ],
      "description": "GPS verification state: verified / not_verified / unavailable \u2014 never hardcoded true or false."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "verified": {
      "type": "boolean",
      "description": "QR validation result of this scan \u2014 true only for a real, valid, matching checkpoint QR scan."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "guard_id",
    "shift_id",
    "checkpoint_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.guard_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.guard_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.guard_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}