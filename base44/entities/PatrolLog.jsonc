{
  "name": "PatrolLog",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "checkpoint_name": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "description": "The guard's scan GPS position at checkpoint verification.",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "checkpoint_location": {
      "type": "object",
      "description": "The checkpoint's configured GPS position this scan was verified against (present when the checkpoint has GPS).",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "distance_metres": {
      "type": "number",
      "description": "Meaningful distance between the checkpoint GPS and the scan GPS. Null when GPS was unavailable for either side."
    },
    "gps_status": {
      "type": "string",
      "enum": [
        "verified",
        "not_verified",
        "unavailable"
      ],
      "description": "GPS verification state: verified / not_verified / unavailable \u2014 never hardcoded true or false."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "verified": {
      "type": "boolean",
      "description": "QR validation result of this scan \u2014 true only for a real, valid, matching checkpoint QR scan."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "guard_id",
    "shift_id",
    "checkpoint_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}