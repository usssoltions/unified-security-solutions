{
  "name": "VenueBooking",
  "type": "object",
  "description": "Advanced venue booking with datetime ranges, multi-day support, facility questions, and collision protection.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Booking start (date + time). Replaces separate booking_date + start_time."
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Booking end (date + time). Supports multi-day if venue allows."
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "Legacy: first day of booking for backward compatibility"
    },
    "start_time": {
      "type": "string",
      "description": "Legacy start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "Legacy end time (HH:MM)"
    },
    "guest_count": {
      "type": "number"
    },
    "purpose": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled",
        "completed",
        "info_requested"
      ],
      "default": "pending"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manager_approval"
      ],
      "default": "automatic"
    },
    "facility_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "JSON-encoded answer"
          },
          "acknowledged": {
            "type": "boolean",
            "description": "For checkbox_acknowledgement type"
          }
        }
      },
      "default": []
    },
    "booking_fee": {
      "type": "number"
    },
    "deposit": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_id": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "info_request_reason": {
      "type": "string",
      "description": "Manager requested more information"
    },
    "special_requirements": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "collision_checked": {
      "type": "boolean",
      "default": false,
      "description": "Server-side collision check performed before save"
    }
  },
  "required": [
    "venue_id",
    "resident_id",
    "start_datetime",
    "end_datetime"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}