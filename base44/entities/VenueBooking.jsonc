{
  "name": "VenueBooking",
  "type": "object",
  "description": "Advanced venue booking with datetime ranges, multi-day support, facility questions, and collision protection. NO PAYMENT FIELDS \u2014 booking is a reservation workflow only; the app never collects fees or deposits. TENANT ACCESS: every tenant read/write goes through the estateAccess backend gateway (server-side collision validation, resident identity stamping and approval workflow); direct client access is restricted to platform admins by RLS.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Booking start (date + time), stored as a LOCAL naive ISO string so estate-local times never shift through UTC."
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Booking end (date + time). Supports multi-day if venue allows. LOCAL naive ISO string."
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "First day of booking (local estate date)"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM, local estate time)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM, local estate time)"
    },
    "guest_count": {
      "type": "number"
    },
    "purpose": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled",
        "completed",
        "info_requested"
      ],
      "default": "pending"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manager_approval"
      ],
      "default": "automatic"
    },
    "facility_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "JSON-encoded answer"
          },
          "acknowledged": {
            "type": "boolean",
            "description": "For checkbox_acknowledgement type"
          }
        }
      },
      "default": []
    },
    "approved_by": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "info_request_reason": {
      "type": "string",
      "description": "Manager requested more information"
    },
    "special_requirements": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "collision_checked": {
      "type": "boolean",
      "default": false,
      "description": "Server-side collision check performed before save"
    }
  },
  "required": [
    "venue_id",
    "resident_id",
    "start_datetime",
    "end_datetime"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}