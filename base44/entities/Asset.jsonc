{
  "name": "Asset",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "asset_name": {
      "type": "string"
    },
    "asset_number": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "vehicle",
        "equipment",
        "electronics",
        "furniture",
        "tools",
        "safety_gear",
        "other"
      ]
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "retired",
        "lost"
      ],
      "default": "active"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_cost": {
      "type": "number"
    },
    "current_value": {
      "type": "number"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "next_service_date": {
      "type": "string",
      "format": "date"
    },
    "service_interval_days": {
      "type": "number"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "performed_by": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "asset_name",
    "asset_number",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}