{
  "name": "Order",
  "type": "object",
  "description": "Estate resident order. TENANT ACCESS: every tenant read/write goes through the estateAccess backend gateway (resident self-service; vendor self-service for own orders; manager oversight). Direct client access is restricted to platform admins by RLS. NO PAYMENT COLLECTION, NO FEES \u2014 price fields exist solely to display informational order totals, which the gateway always computes server-side from the submitted items (sum of quantity x catalogue unit_price). No delivery fees, surcharges, balances, paid/unpaid status, invoicing or settlement exist in the application.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "restaurant",
        "shop",
        "laundry",
        "service"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number",
            "description": "Informational catalogue value at order time."
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "subtotal": {
      "type": "number",
      "description": "Informational only \u2014 sum of item values, computed server-side."
    },
    "total": {
      "type": "number",
      "description": "Informational only \u2014 equals subtotal (items sum; no fees are ever added)."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "delivery_address": {
      "type": "string",
      "description": "Logistics information only \u2014 no fee is attached to delivery."
    },
    "delivery_notes": {
      "type": "string"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date-time"
    },
    "placed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "resident_id",
    "vendor_id",
    "order_type",
    "items"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}