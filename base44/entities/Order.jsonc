{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation. Stamped at creation from the ordering resident's authoritative tenant."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "restaurant",
        "shop",
        "laundry",
        "service"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_id": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "string"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date-time"
    },
    "placed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "resident_id",
    "vendor_id",
    "order_type",
    "items"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "data.vendor_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "data.vendor_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}