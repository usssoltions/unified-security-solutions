{
  "name": "ReportShowcasePack",
  "type": "object",
  "description": "Report & Notification Showcase: ONE generated showcase pack for one customer. Contents are INERT rendered examples built from that customer's DEMO-seeded records using the platform's real notification/report templates \u2014 generating or previewing never alters incidents/tasks/schedules, never triggers gate actions and never invokes escalation workflows. STATE MACHINE: generated -> preview_sent -> approved -> sending -> sent (cancelled at any pre-send stage). APPROVAL GATE: customer delivery is only possible after an explicit approval recording the pack's content fingerprint and a typed acknowledgment; any regeneration changes the fingerprint and invalidates a prior approval. FROZEN ATTACHMENTS: report items' REAL report files (branded PDFs/CSV from the platform's actual report generators) are built and uploaded to PRIVATE storage ONCE at pack generation \u2014 preview and customer delivery REUSE the exact frozen files, so later demo-data changes can never alter an approved pack (regeneration creates a new pack + fingerprint). Contents only ever store attachment METADATA (filename/generator/record ids/frozen file uri), never file bytes. Every send is an EXPLICIT platform-admin action through the reportShowcase gateway with recipients validated against the customer's ShowcaseConfig (demo-suppression of AUTOMATED dispatch is untouched: this is a manually authorised showcase exception). GATEWAY-ONLY access; direct client access restricted to platform administration by RLS.",
  "properties": {
    "pack_number": {
      "type": "string",
      "description": "Human-readable pack reference (e.g. SHOW-20261002-K4F9)."
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "demo_batch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "The demo seed batches whose records this pack draws from \u2014 provenance cross-reference."
    },
    "status": {
      "type": "string",
      "enum": [
        "generated",
        "preview_sent",
        "approved",
        "sending",
        "sent",
        "cancelled"
      ],
      "default": "generated"
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          },
          "include": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "default": []
    },
    "contents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "demo_record_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "generator": {
                  "type": "string",
                  "description": "Server-side generator id that builds the file (e.g. daily_access_pdf, daily_access_csv, hospitality_visits_pdf, daily_activity_pdf, monthly_incident_pdf, monthly_maintenance_pdf)."
                },
                "record_ids": {
                  "type": [
                    "array",
                    "object",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "description": "Demo record ids the generator renders (array, or object of per-entity arrays for multi-source reports)."
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Optional reporting-date label for date-bounded generators."
                },
                "file_uri": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "INTERNAL frozen attachment: private storage uri of the REAL report file built and uploaded at pack generation \u2014 preview and customer delivery reuse this exact file."
                }
              },
              "required": [
                "filename",
                "generator"
              ]
            },
            "default": [],
            "description": "Metadata of the REAL downloadable report files attached to this item when it is sent (frozen at pack generation; bytes never stored in the pack)."
          }
        }
      },
      "default": [],
      "description": "Rendered, inert example content per template."
    },
    "branding_snapshot": {
      "type": "object",
      "properties": {
        "brand_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "accent_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "logo_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "secondary_logo_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Customer-level secondary document logo (e.g. Grid Protection eagle alongside the GRID GATE primary)."
        },
        "missing_overrides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Branding-dependent overrides still outstanding (e.g. site secondary logo)."
        }
      },
      "description": "Customer branding used for the pack render."
    },
    "content_fingerprint": {
      "type": "string",
      "description": "SHA-256 of the pack's selections + contents + branding (incl. the frozen attachment file uris). Approval and customer delivery are bound to it."
    },
    "preview": {
      "type": "object",
      "properties": {
        "sent_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recipient": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "template_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "sent",
                  "failed",
                  "skipped"
                ]
              },
              "attempts": {
                "type": "number",
                "default": 0
              },
              "dedup_key": {
                "type": "string"
              },
              "last_error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sent_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "default": []
          }
        }
      },
      "description": "Owner preview delivery ledger (sales mailbox only)."
    },
    "approval": {
      "type": "object",
      "properties": {
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approved_by_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Content fingerprint the approval was granted against."
        },
        "acknowledgment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "customer_delivery": {
      "type": "object",
      "properties": {
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "bcc_copy_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "template_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "sent",
                  "failed",
                  "skipped",
                  "cancelled"
                ]
              },
              "attempts": {
                "type": "number",
                "default": 0
              },
              "dedup_key": {
                "type": "string"
              },
              "last_error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sent_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "default": []
          }
        }
      },
      "description": "Customer delivery ledger (customer address + identical owner copy)."
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "pack_number",
    "customer_id",
    "status",
    "content_fingerprint"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "read": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "update": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}