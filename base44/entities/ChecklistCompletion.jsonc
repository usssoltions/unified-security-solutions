{
  "name": "ChecklistCompletion",
  "type": "object",
  "description": "Patrol checklist completion submitted with a checkpoint scan. Tenant ownership is stamped server-side by the checkpointSubmission gateway from the guard's verified shift. IDEMPOTENT via submission_key: a retry or offline sync with the same key returns the existing record instead of creating a duplicate. SUSPENSION (direct entity access): every non-admin RLS branch additionally requires data.customer_id != the caller's server-stamped User.tenant_suspended marker (set by customerAccess on suspension, cleared on reactivation) \u2014 a suspended customer's users are blocked from direct SDK reads/writes outside the checkpointSubmission gateway, with no effect on any other user (a missing/null marker never blocks).",
  "properties": {
    "submission_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL idempotency key shared with the linked PatrolLog (client-generated UUID, stamped server-side). Null on demo/legacy records."
    },
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership inherited from the completing guard's shift/site."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped access control."
    },
    "template_id": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "qr_code_scanned": {
      "type": "string"
    },
    "completed_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "Issue note captured for this item (Issue answers). Cleared for Pass / Not applicable."
          },
          "photo_url": {
            "type": "string"
          }
        }
      }
    },
    "media": {
      "type": "array",
      "default": [],
      "description": "General scan media attached at submission: [{type: 'photo'|'video', url}].",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "properties": {
        "data_url": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "enum": [
            "digital",
            "pin",
            "biometric"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete",
        "skipped"
      ],
      "default": "incomplete"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "template_id",
    "guard_id",
    "shift_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.guard_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.guard_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.guard_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.customer_id": {
                "$ne": "{{user.data.tenant_suspended}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}