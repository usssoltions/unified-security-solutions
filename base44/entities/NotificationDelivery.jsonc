{
  "name": "NotificationDelivery",
  "type": "object",
  "description": "Delivery audit record for every notification sent through any channel. Tracks success/failure, retries, and provider response. Idempotency key prevents duplicate deliveries for the same event+recipient+channel. The 'task_event' channel marks a Task Scheduling event (e.g. a deadline-threshold overdue alert) as dispatched ONCE across all its channels \u2014 the idempotency key 'task_event:<eventKey>' makes later sweep runs skip the whole event so immediate alerts are never duplicated. AUDIT STANDARD (2026-09-22): every important application-controlled EMAIL attempt is recorded here via the shared auditedEmail helper with event_type, reference_id and branding_source (customer/reseller/platform). Never logged in these records: authentication tokens, passwords, invitation tokens, full sensitive message bodies or protected media contents.",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "description": "Coarse correspondence type for audit querying (e.g. daily_activity_report, alarm_dispatch, checkpoint_qr_share)."
    },
    "reference_id": {
      "type": "string",
      "description": "ID of the authoritative record/entity the correspondence is about (report id, alarm response id, schedule run identifier)."
    },
    "branding_source": {
      "type": "string",
      "enum": [
        "customer",
        "reseller",
        "platform"
      ],
      "description": "Which level of the branding hierarchy won for this correspondence (Customer override \u2192 Reseller default \u2192 Platform default)."
    },
    "notification_id": {
      "type": "string",
      "description": "ID of the related Notification entity if in-app"
    },
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string",
      "description": "User ID or external recipient ID"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_address": {
      "type": "string",
      "description": "Email, telegram chat ID, or OneSignal player ID"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "in_app",
        "push",
        "telegram",
        "task_event"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "retrying",
        "suppressed",
        "skipped"
      ],
      "default": "pending"
    },
    "send_time": {
      "type": "string",
      "format": "date-time"
    },
    "provider_response": {
      "type": "string",
      "description": "SAFE failure reason only \u2014 truncated provider exception message. Never contains tokens, passwords or message bodies."
    },
    "retries": {
      "type": "number",
      "default": 0
    },
    "idempotency_key": {
      "type": "string",
      "description": "Prevents duplicate deliveries for the same event+recipient+channel"
    },
    "skip_reason": {
      "type": "string",
      "description": "Reason the channel was skipped (e.g. NO_TELEGRAM_CHAT_ID, TELEGRAM_DISABLED, NO_EMAIL, NO_PUSH_TOKEN)."
    }
  },
  "required": [
    "event_key",
    "channel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "update": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}