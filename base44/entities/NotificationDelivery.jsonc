{
  "name": "NotificationDelivery",
  "type": "object",
  "description": "Delivery audit record for every notification sent through any channel. Tracks success/failure, retries, and provider response. Idempotency key prevents duplicate deliveries for the same event+recipient+channel. The 'task_event' channel marks a Task Scheduling event (e.g. a deadline-threshold overdue alert) as dispatched ONCE across all its channels \u2014 the idempotency key 'task_event:<eventKey>' makes later sweep runs skip the whole event so immediate alerts are never duplicated. DELIVERY-SAFETY AUDIT (2026-09-22): every audited email attempt now also records the server-controlled delivery_mode (production/test/preview), the INTENDED recipient address (differs from recipient_address in test mode, where every recipient is rewritten to the TEST_MAILBOX allowlist), and the template_name of the central transactional renderer used. Blocked/skipped attempts are recorded truthfully (status 'skipped' with skip_reason such as TEST_RECORD_BLOCKED_IN_PRODUCTION, BLOCKED_INVALID_DELIVERY_MODE, PREVIEW_MODE, TEST_MODE_NO_ALLOWLISTED_MAILBOX). Never logged in these records: authentication tokens, passwords, invitation tokens, full sensitive message bodies or protected media contents.",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "description": "Coarse correspondence type for audit querying (e.g. daily_activity_report, alarm_dispatch, checkpoint_qr_share)."
    },
    "reference_id": {
      "type": "string",
      "description": "ID of the authoritative record/entity the correspondence is about (report id, alarm response id, schedule run identifier)."
    },
    "branding_source": {
      "type": "string",
      "enum": [
        "customer",
        "reseller",
        "platform"
      ],
      "description": "Which level of the branding hierarchy won for this correspondence (Customer override \u2192 Reseller default \u2192 Platform default)."
    },
    "template_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Central transactional template used for this correspondence (e.g. incident_alert, missed_stay_awake_check, scheduled_report)."
    },
    "delivery_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "production",
        "test",
        "preview",
        null
      ],
      "description": "Server-controlled delivery-safety mode in force when the attempt was made. 'test' means the effective recipient was rewritten to the TEST_MAILBOX allowlist and the subject prefixed '[TEST]'."
    },
    "intended_recipient_address": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ORIGINAL intended recipient before test-mode rewriting. Differs from recipient_address only in test mode; null when identical/unknown."
    },
    "notification_id": {
      "type": "string",
      "description": "ID of the related Notification entity if in-app"
    },
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string",
      "description": "User ID or external recipient ID"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_address": {
      "type": "string",
      "description": "The EFFECTIVE address the correspondence actually went to: email, telegram chat ID, or OneSignal player ID. In test mode this is the allowlisted test mailbox, with the original recorded in intended_recipient_address."
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "in_app",
        "push",
        "telegram",
        "task_event"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "retrying",
        "suppressed",
        "skipped"
      ],
      "default": "pending"
    },
    "send_time": {
      "type": "string",
      "format": "date-time"
    },
    "provider_response": {
      "type": "string",
      "description": "SAFE failure reason only \u2014 truncated provider exception message. Never contains tokens, passwords or message bodies."
    },
    "retries": {
      "type": "number",
      "default": 0
    },
    "idempotency_key": {
      "type": "string",
      "description": "Prevents duplicate deliveries for the same event+recipient+channel (keyed on the INTENDED recipient so test-mode rewriting never collapses distinct recipients)."
    },
    "skip_reason": {
      "type": "string",
      "description": "Reason the channel was skipped (e.g. NO_TELEGRAM_CHAT_ID, TELEGRAM_DISABLED, NO_EMAIL, NO_PUSH_TOKEN, TEST_RECORD_BLOCKED_IN_PRODUCTION, BLOCKED_INVALID_DELIVERY_MODE, PREVIEW_MODE, TEST_MODE_NO_ALLOWLISTED_MAILBOX, RECIPIENT_NOT_APPROVED)."
    }
  },
  "required": [
    "event_key",
    "channel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "update": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}