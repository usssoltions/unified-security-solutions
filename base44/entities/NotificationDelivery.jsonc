{
  "name": "NotificationDelivery",
  "type": "object",
  "description": "Delivery audit record for every notification sent through any channel. Tracks success/failure, retries, and provider response. Idempotency key prevents duplicate deliveries for the same event+recipient+channel.",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "notification_id": {
      "type": "string",
      "description": "ID of the related Notification entity if in-app"
    },
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string",
      "description": "User ID or external recipient ID"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_address": {
      "type": "string",
      "description": "Email, telegram chat ID, or OneSignal player ID"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "in_app",
        "push",
        "telegram"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "retrying",
        "suppressed",
        "skipped"
      ],
      "default": "pending"
    },
    "send_time": {
      "type": "string",
      "format": "date-time"
    },
    "provider_response": {
      "type": "string"
    },
    "retries": {
      "type": "number",
      "default": 0
    },
    "idempotency_key": {
      "type": "string",
      "description": "Prevents duplicate deliveries for the same event+recipient+channel"
    },
    "skip_reason": {
      "type": "string",
      "description": "Reason the channel was skipped (e.g. NO_TELEGRAM_CHAT_ID, TELEGRAM_DISABLED, NO_EMAIL, NO_PUSH_TOKEN)."
    }
  },
  "required": [
    "event_key",
    "channel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "update": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}