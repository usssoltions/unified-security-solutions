{
  "name": "SignalingMessage",
  "type": "object",
  "description": "Persistent store for WebRTC signaling messages so rtcSignaling works reliably across serverless invocations.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "from_user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "offer",
        "answer",
        "candidate",
        "call_answered",
        "call_ended"
      ]
    },
    "call_id": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    }
  },
  "required": [
    "to_user_id",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}