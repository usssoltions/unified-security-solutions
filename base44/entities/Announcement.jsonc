{
  "name": "Announcement",
  "type": "object",
  "description": "ESTATE MANAGEMENT module \u2014 a published community announcement/notice. TENANT ACCESS: every tenant read/write goes through the estateAccess backend gateway, which resolves the caller's authoritative tenant server-side (withTenant pattern); a resident of Estate A can never read Estate B's announcements. Publishing is the single-intent publish action, which also dispatches the branded notification through estateNotify. Direct client access is restricted to platform admins by RLS.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership \u2014 resolved from the publishing manager's authoritative tenant; a resident of Estate A can never read Estate B's announcements."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped access."
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "news",
        "maintenance",
        "event",
        "security",
        "emergency",
        "advertisement",
        "promotion",
        "other"
      ],
      "default": "news"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "all",
        "residents",
        "guards",
        "vendors",
        "specific"
      ],
      "default": "all"
    },
    "target_units": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "send_email": {
      "type": "boolean",
      "default": false,
      "description": "Publish-time delivery control honored SERVER-SIDE by the estateNotify gateway (email + telegram channels for non-critical announcements; urgent/security/emergency announcements always use every channel)."
    },
    "send_push": {
      "type": "boolean",
      "default": true,
      "description": "Publish-time delivery control honored SERVER-SIDE by the estateNotify gateway native push channel."
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}