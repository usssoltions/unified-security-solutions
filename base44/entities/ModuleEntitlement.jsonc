{
  "name": "ModuleEntitlement",
  "type": "object",
  "description": "Records which commercial modules are licensed for a customer or site. Navigation and backend access are gated by these entitlements \u2014 never rely on UI hiding alone. A customer's module allocation must be a subset of the modules licensed to the reseller (ResellerEntitlement); this is enforced server-side by the manageCustomerEntitlement backend function.",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string",
      "description": "Optional: scope entitlement to a specific site/location"
    },
    "module_key": {
      "type": "string",
      "description": "Module key (free string to support future modules). Must be a module the reseller is licensed for."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "licence_start": {
      "type": "string",
      "format": "date-time"
    },
    "licence_end": {
      "type": "string",
      "format": "date-time"
    },
    "licence_limit": {
      "type": "number",
      "description": "Quantity limit (e.g., max sites, max users, max devices)"
    },
    "configuration": {
      "type": "object",
      "description": "Module-specific configuration JSON"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "suspended",
        "pending"
      ],
      "default": "active"
    }
  },
  "required": [
    "customer_id",
    "module_key",
    "enabled"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}