{
  "name": "ReportSchedule",
  "type": "object",
  "description": "TENANT-SCOPED automated report schedule (one row per configured recurring report). The runReportSchedules dispatcher (scheduled workflow) executes schedules whose due datetime (frequency + day + time) has passed since last_sent_at, sending ONLY to the schedule's own tenant's approved recipients, validated server-side by sendScheduledReport (types incident_maintenance_summary / guard_performance / site_activity / comprehensive_monthly) or generateAIReport (legacy AI report types). TENANT ISOLATION: customer admins read and manage ONLY their own organisation's schedules (customer_id stamped at creation); the legacy pool of unscoped records remains platform-visible. Legacy `status` ('active'/'paused') is kept in sync with the authoritative is_active flag.",
  "properties": {
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tenant ownership, stamped at creation from the creator's authoritative tenant. Null = platform-managed legacy pool."
    },
    "reseller_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Display name of the schedule."
    },
    "report_type": {
      "type": "string",
      "description": "Report type. Dispatcher types (auto-sent): incident_maintenance_summary, guard_performance, site_activity, comprehensive_monthly. Legacy AI-report types (manual test generation via generateAIReport): daily_activity, weekly_summary, monthly_performance, maintenance_summary, incidents, patrol_coverage, stay_awake, shift_attendance, checklist_completion, asset_register, site_analytics, incident_trends."
    },
    "frequency": {
      "type": "string",
      "description": "daily | weekly | monthly | real-time | realtime | yearly. The dispatcher auto-sends daily/weekly/monthly; real-time and yearly schedules are manual-send only and are never auto-executed."
    },
    "schedule_day": {
      "type": [
        "number",
        "null"
      ],
      "description": "Day of month for monthly reports (1-31)"
    },
    "send_day": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy weekly day name (e.g. 'Monday') used by the AI-report scheduler UI."
    },
    "schedule_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "Time to send report (HH:MM, SAST)."
    },
    "send_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy alias of schedule_time used by the AI-report scheduler UI."
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "admin",
              "custom"
            ]
          }
        }
      },
      "default": []
    },
    "email_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Legacy AI-scheduler recipient address list."
    },
    "whatsapp_recipients": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Legacy WhatsApp recipient entries \u2014 never automatically dispatched (no automated WhatsApp channel exists); reported as skipped."
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_comparative": {
      "type": "boolean",
      "default": false,
      "description": "Legacy comparative-analysis flag from the AI-report scheduler UI."
    },
    "compare_with": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy comparative period selector (e.g. previous_day)."
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "active",
        "paused",
        null
      ],
      "description": "Legacy AI-scheduler status toggle; kept in sync with is_active by the UI."
    },
    "include_admins": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_sent": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Legacy last-sent timestamp from the AI-report scheduler UI."
    }
  },
  "required": [
    "report_type",
    "frequency"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    }
  }
}