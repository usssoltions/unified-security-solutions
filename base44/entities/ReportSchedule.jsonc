{
  "name": "ReportSchedule",
  "type": "object",
  "properties": {
    "report_type": {
      "type": "string",
      "enum": [
        "incident_maintenance_summary",
        "guard_performance",
        "site_activity",
        "comprehensive_monthly"
      ],
      "description": "Type of report to generate"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "real-time"
      ],
      "default": "monthly"
    },
    "schedule_day": {
      "type": "number",
      "description": "Day of month for monthly reports (1-31)"
    },
    "schedule_time": {
      "type": "string",
      "description": "Time to send report (HH:MM format)"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "admin",
              "custom"
            ]
          }
        }
      },
      "default": []
    },
    "include_admins": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "report_type",
    "frequency"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}