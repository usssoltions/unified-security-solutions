{
  "name": "ReportSchedule",
  "type": "object",
  "description": "TENANT-SCOPED automated report schedule (one row per configured recurring report). Dispatched by the runReportSchedules scheduler function (scheduled workflow) \u2014 a schedule only runs when is_active is true and its due datetime has passed since last_sent_at; delivery goes ONLY to the schedule's own tenant's approved recipients (ExternalRecipient + tenant users), validated server-side by sendScheduledReport. TENANT ISOLATION: customer admins read and manage ONLY their own organisation's schedules (customer_id is stamped at creation); the legacy pool of unscoped records remains platform-visible. Legacy field `status` ('active'/'paused') is honoured alongside the authoritative is_active flag.",
  "properties": {
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tenant ownership, stamped at creation from the creator's authoritative tenant. Null = platform-managed legacy pool."
    },
    "reseller_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Display name of the schedule."
    },
    "report_type": {
      "type": "string",
      "enum": [
        "incident_maintenance_summary",
        "guard_performance",
        "site_activity",
        "comprehensive_monthly"
      ],
      "description": "Type of report to generate"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "real-time"
      ],
      "default": "monthly"
    },
    "schedule_day": {
      "type": "number",
      "description": "Day of month for monthly reports (1-31)"
    },
    "send_day": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy weekly day name (e.g. 'Monday') used by the AI-report scheduler UI."
    },
    "schedule_time": {
      "type": "string",
      "description": "Time to send report (HH:MM format)"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "admin",
              "custom"
            ]
          }
        }
      },
      "default": []
    },
    "email_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Legacy AI-scheduler recipient address list."
    },
    "whatsapp_recipients": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Legacy WhatsApp recipient entries \u2014 never automatically dispatched (no automated WhatsApp channel exists); reported as skipped."
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "active",
        "paused",
        null
      ],
      "description": "Legacy AI-scheduler status toggle; kept in sync with is_active by the UI."
    },
    "include_admins": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "report_type",
    "frequency"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": null
            },
            {
              "user_condition": {
                "admin_level": "platform"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    }
  }
}