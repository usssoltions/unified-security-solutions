{
  "name": "PatrolPlan",
  "type": "object",
  "description": "Assigned patrol plan (supervisor-planned route for a guard). TENANT ISOLATION (was world-readable \u2014 read:null, fixed 2026-09-21): reads are now customer-scoped with a RESELLER-ADMIN-only reseller_id branch (admin_level 'reseller'); the assigned guard and the planner see their own records; platform admins retain oversight. Create/update additionally allow the tenant-scoped pattern (previously platform-only, which blocked tenant supervisors).",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access"
    },
    "name": {
      "type": "string",
      "description": "Patrol plan name"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "scheduled_patrol_id": {
      "type": "string",
      "description": "Link to ScheduledPatrol"
    },
    "assigned_to": {
      "type": "string",
      "description": "Guard ID"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "completed",
        "cancelled",
        "failed"
      ],
      "default": "pending"
    },
    "route_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkpoint_id": {
            "type": "string"
          },
          "checkpoint_name": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "notes": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "guard_feedback": {
            "type": "string"
          },
          "gps_verified": {
            "type": "boolean"
          }
        }
      },
      "default": []
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "ai_recommendations": {
      "type": "string"
    },
    "high_risk_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_duration_minutes": {
      "type": "number"
    },
    "actual_duration_minutes": {
      "type": "number"
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "guard_notes": {
      "type": "string"
    },
    "linked_incidents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "completion_score": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "site_id",
    "assigned_to"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}