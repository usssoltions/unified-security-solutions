{
  "name": "Reseller",
  "type": "object",
  "description": "A reseller/partner organization that manages multiple customer tenants. Security companies may operate as resellers, providing USS solutions to their own clients. Tenant isolation is enforced via a `members` array of authorised User IDs (membership RLS), NOT via {{user.data.reseller_id}} \u2014 the platform session token does not carry custom User fields, so {{user.data.*}} resolves to null in RLS. `members` is managed server-side only; reseller admins cannot edit it directly. White-label branding (app_name, logo_url, primary_color, accent_color, support_*) lives directly on this entity and is inherited by all customers belonging to the reseller.",
  "properties": {
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "app_name": {
      "type": "string",
      "description": "White-label application / business name shown in the reseller's branded app header and branded surfaces. Distinct from the reseller's trading name. When blank, the platform default product name is used."
    },
    "logo_url": {
      "type": "string",
      "description": "Reseller logo file URL (uploaded via the Branding editor). Inherited by the reseller's customers. Null/empty falls back to the platform default mark."
    },
    "primary_color": {
      "type": "string",
      "description": "Reseller primary brand colour (hex). Applied to active navigation, branded headers and primary accents. Must NOT override semantic safety/status colours. Validated to a hex value before use."
    },
    "accent_color": {
      "type": "string",
      "description": "Reseller accent / action colour (hex). Applied to primary action buttons, links and highlights. Must NOT override semantic safety/status colours. Validated to a hex value before use."
    },
    "support_name": {
      "type": "string"
    },
    "support_email": {
      "type": "string"
    },
    "support_phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs authorised to access this reseller (membership-based RLS). Read access is granted when the authenticated user's {{user.id}} is present in this array. Managed server-side only via applyMyPendingScope / platform admin functions \u2014 reseller admins have no direct write access to this field.",
      "default": []
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.members": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}