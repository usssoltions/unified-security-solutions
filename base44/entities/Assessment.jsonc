{
  "name": "Assessment",
  "type": "object",
  "description": "Medical module: Completed patient assessment. Stores the template version used so historical results remain interpretable. CLINICAL \u2014 reception and employer portal users have ZERO access; the medicalAccess gateway enforces therapist-ownership (therapists act on their own assessments) with practice-admin oversight. GATEWAY-ONLY ACCESS: direct client access is restricted to platform administration (built-in role 'admin' and admin_level 'platform') by RLS. Deletion is not offered through the gateway (clinical preservation).",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "employer_id": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "therapist_id": {
      "type": "string"
    },
    "therapist_name": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "template_version": {
      "type": "number",
      "description": "Version of the template used for this assessment"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section_name": {
            "type": "string"
          },
          "question_id": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "question_type": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "JSON-encoded answer (string, number, array, etc.)"
          }
        }
      },
      "default": []
    },
    "calculated_scores": {
      "type": "object",
      "description": "Calculated scores from template scoring rules"
    },
    "findings": {
      "type": "string"
    },
    "recommendations": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by_id": {
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "report_id": {
      "type": "string",
      "description": "Generated MedicalReport entity if a report was created"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "amended"
      ],
      "default": "in_progress"
    }
  },
  "required": [
    "customer_id",
    "patient_id",
    "template_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}