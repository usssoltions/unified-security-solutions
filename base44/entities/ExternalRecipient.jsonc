{
  "name": "ExternalRecipient",
  "type": "object",
  "description": "A notification recipient who is NOT an application user. Used for distributing reports and notifications to client representatives, trustees, HR contacts, contractors, etc. They do not require login credentials.",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telegram_chat_id": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "client_representative",
        "trustee",
        "hr_contact",
        "manager",
        "contractor",
        "other"
      ],
      "default": "other"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "customer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.reseller_id": "{{user.reseller_id}}"
        },
        {
          "data.customer_id": "{{user.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.reseller_id": "{{user.reseller_id}}"
        },
        {
          "data.customer_id": "{{user.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.reseller_id": "{{user.reseller_id}}"
        },
        {
          "data.customer_id": "{{user.customer_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}