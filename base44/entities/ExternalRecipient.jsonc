{
  "name": "ExternalRecipient",
  "type": "object",
  "description": "A notification recipient who is NOT an application user. Used for distributing reports and notifications to client representatives, trustees, HR contacts, contractors, etc. They do not require login credentials.",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telegram_chat_id": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "client_representative",
        "trustee",
        "hr_contact",
        "manager",
        "contractor",
        "other"
      ],
      "default": "other"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "telephone": {
      "type": "string",
      "description": "Phone/WhatsApp number for manual wa.me distribution."
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number (manual wa.me workflow only)."
    },
    "telegram_connected": {
      "type": "boolean",
      "default": false
    },
    "telegram_connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "telegram_username": {
      "type": "string"
    },
    "role_title": {
      "type": "string"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "telegram_enabled": {
      "type": "boolean",
      "default": true
    },
    "whatsapp_manual_enabled": {
      "type": "boolean",
      "default": false
    },
    "reports_enabled": {
      "type": "boolean",
      "default": true
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "report_preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "daily_access",
          "weekly_analysis",
          "monthly_comparison",
          "incident_summary",
          "maintenance_summary"
        ]
      },
      "default": []
    },
    "notification_preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "telegram",
          "whatsapp",
          "in_app"
        ]
      },
      "default": [
        "email"
      ]
    }
  },
  "required": [
    "name",
    "customer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "data.reseller_id": "{{user.data.reseller_id}}"
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "data.reseller_id": "{{user.data.reseller_id}}"
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "data.reseller_id": "{{user.data.reseller_id}}"
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}