{
  "name": "ExternalRecipient",
  "type": "object",
  "description": "A notification/report recipient who is NOT required to have an application login. Used for distributing reports (Daily Access Control Report, weekly/monthly analysis) and notifications to client representatives, trustees, HR contacts, contractors, etc. THE ONE authoritative tenant-scoped report-recipient system: external addresses never receive fake system user accounts; authorised INTERNAL users may also be selected as recipients via the optional user_id link (the record still carries the email and remains deduplicated by normalized email at send time). TENANT ISOLATION: reads are customer-scoped; the reseller_id branch is reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every customer's external contact list (names, emails, phone numbers) to every other customer under the same reseller (confirmed cross-customer defect class 2026-09-21). All tenant-level management flows through the reportRecipientAccess gateway, which resolves the caller's customer scope server-side and never trusts a client-supplied customer_id.",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string",
      "description": "Optional site scoping: when set, the recipient receives reports for THIS site only; null/empty = all explicitly authorised sites of the customer."
    },
    "user_id": {
      "type": "string",
      "description": "Optional link to an INTERNAL app user selected as a report recipient (e.g. Customer Administrator, Control Room Operator, Estate Manager). When set, the recipient mirrors that user's email; delivery is deduplicated by normalized email so an internal user + external record for the same address receives ONE copy. The user is never auto-subscribed \u2014 only explicitly configured recipients receive reports."
    },
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Delivery email address \u2014 ALWAYS normalized (trim + lowercase) by the reportRecipientAccess gateway; duplicates within the same customer are rejected/merged so the same address can never receive two copies."
    },
    "telegram_chat_id": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "client_representative",
        "trustee",
        "hr_contact",
        "manager",
        "contractor",
        "other"
      ],
      "default": "other"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "telephone": {
      "type": "string",
      "description": "Phone/WhatsApp number for manual wa.me distribution."
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number (manual wa.me workflow only)."
    },
    "telegram_connected": {
      "type": "boolean",
      "default": false
    },
    "telegram_connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "telegram_username": {
      "type": "string"
    },
    "role_title": {
      "type": "string"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "telegram_enabled": {
      "type": "boolean",
      "default": true
    },
    "whatsapp_manual_enabled": {
      "type": "boolean",
      "default": false
    },
    "reports_enabled": {
      "type": "boolean",
      "default": true
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "report_preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "daily_access",
          "daily_access_opt_out",
          "weekly_analysis",
          "monthly_comparison",
          "incident_summary",
          "maintenance_summary"
        ]
      },
      "default": [],
      "description": "Which reports this recipient receives. Empty array = all reports the recipient is otherwise authorised for (backwards-compatible default); 'daily_access' opts in to the 17:00 Daily Access Control Report; 'daily_access_opt_out' is the EXPLICIT opt-out marker for it \u2014 without this marker an opt-out would collapse to the empty array and the recipient would keep receiving the report under the legacy all-reports default. The opt-out marker takes precedence in the daily report resolver and is stripped whenever the recipient is re-enabled."
    },
    "notification_preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "telegram",
          "whatsapp",
          "in_app"
        ]
      },
      "default": [
        "email"
      ]
    }
  },
  "required": [
    "name",
    "customer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}