{
  "name": "OperationalTask",
  "type": "object",
  "description": "Operations module: Scheduled operational task \u2014 a DISTINCT workflow from guard shift scheduling. One record = one task occurrence. Recurring tasks store a shared series id (recurrence_key prefix) and parent_task_id; occurrences are generated server-side (bounded rolling window, deduplicated by recurrence_key) by the scheduledTaskAccess backend function. TENANT ACCESS PATTERN: this entity deliberately carries NO {{user.data.*}} RLS rules \u2014 session tokens do not reliably expose custom User fields (customer_id/reseller_id), so template-based tenant scoping is unproven on this platform. ALL tenant reads/writes go through the scheduledTaskAccess backend function, which resolves the caller's tenant server-side from their User record (the proven pattern of attendanceAccess/getTenantUsers), enforces the OPERATIONS / COMPLETE_SECURITY module licence, validates site/assignee tenant membership, and fails closed for unauthorized roles. Direct client access below is restricted to platform admins only \u2014 Customer A can never reach Customer B's tasks.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Task instructions / description"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "check_guard",
        "contact_site",
        "verify_patrol",
        "follow_up_incident",
        "review_alarm",
        "confirm_shift",
        "contact_customer",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "User ID assigned to complete the task"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string",
      "description": "User ID who created the task"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "SAST calendar date the task is scheduled for (YYYY-MM-DD)"
    },
    "scheduled_time": {
      "type": "string",
      "description": "SAST local time (HH:MM) the task is scheduled for"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO instant derived from scheduled_date + scheduled_time at the SAST fixed offset (+02:00). Used for sorting and overdue comparison."
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional due deadline (UTC ISO). Open tasks past this point are swept to status 'overdue' by scheduledTaskAccess."
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "acknowledged",
        "in_progress",
        "awaiting",
        "completed",
        "overdue",
        "cancelled"
      ],
      "default": "new"
    },
    "recurrence_type": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "weekdays",
        "monthly",
        "custom"
      ],
      "default": "none",
      "description": "Recurrence rule for the series (stored on the parent and every generated occurrence)."
    },
    "recurrence_weekdays": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Selected weekdays (0=Sun .. 6=Sat) for 'weekdays' recurrence.",
      "default": []
    },
    "recurrence_interval_days": {
      "type": "number",
      "default": 1,
      "description": "Interval in days for 'custom' recurrence."
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "description": "Optional last date occurrences may be generated for (inclusive)."
    },
    "recurrence_key": {
      "type": "string",
      "description": "Series dedup key: '<seriesId>:<scheduled_date>'. Occurrence generation is idempotent \u2014 a key already present is never duplicated."
    },
    "parent_task_id": {
      "type": "string",
      "description": "The series parent task id for generated occurrences."
    },
    "completion_notes_required": {
      "type": "boolean",
      "default": false
    },
    "completion_notes": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_by": {
      "type": "string",
      "description": "Supervisor who verified completion"
    },
    "verified_by_name": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "related_entity": {
      "type": "string",
      "description": "Entity type if related (incident, maintenance, shift, etc.)"
    },
    "related_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "title",
    "task_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}