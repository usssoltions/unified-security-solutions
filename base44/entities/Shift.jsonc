{
  "name": "Shift",
  "type": "object",
  "properties": {
    "guard_id": {
      "type": "string",
      "description": "User ID of assigned guard"
    },
    "guard_name": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "open",
        "accepted",
        "active",
        "completed",
        "missed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the 2-hour reminder email has been sent \u2014 prevents duplicate reminders"
    },
    "ended_notified": {
      "type": "boolean",
      "default": false,
      "description": "Server source of truth: set true once the shift-end alert has fired and supervisors were notified. Prevents duplicate end-of-shift notifications and the recurring alert-sound loop on remount/reload."
    },
    "ended_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the shift-end notification was first dispatched."
    },
    "guard_ack_status": {
      "type": "string",
      "enum": [
        "accepted",
        "declined",
        "revision_requested"
      ],
      "description": "Guard's acknowledgement response to the shift"
    },
    "guard_ack_signature": {
      "type": "string",
      "description": "Base64 signature from guard"
    },
    "guard_ack_note": {
      "type": "string",
      "description": "Note from guard (e.g. revision reason)"
    },
    "guard_ack_at": {
      "type": "string",
      "format": "date-time"
    },
    "clock_in": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "clock_out": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "is_overtime": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "site_id",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}