{
  "name": "ShiftSwapRequest",
  "type": "object",
  "description": "Guard shift swap request. TENANT ISOLATION (was world-readable \u2014 read:null, fixed 2026-09-21): reads are now customer-scoped with a RESELLER-ADMIN-only reseller_id branch (admin_level 'reseller'); the requesting guard, the target guard and the creator always see their own requests; platform admins retain oversight. New records carry customer_id/reseller_id (stamped at creation); legacy unscoped records remain visible via own-record branches and to platform admins.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access"
    },
    "requesting_guard_id": {
      "type": "string",
      "description": "Guard who wants to swap their shift"
    },
    "requesting_guard_name": {
      "type": "string"
    },
    "target_guard_id": {
      "type": "string",
      "description": "Guard being asked to swap"
    },
    "target_guard_name": {
      "type": "string"
    },
    "original_shift_id": {
      "type": "string",
      "description": "Shift the requester wants to swap away"
    },
    "original_shift_details": {
      "type": "object",
      "properties": {
        "site_name": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        }
      }
    },
    "offered_shift_id": {
      "type": "string",
      "description": "Optional: shift offered in exchange"
    },
    "offered_shift_details": {
      "type": "object",
      "properties": {
        "site_name": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        }
      }
    },
    "reason": {
      "type": "string",
      "description": "Why the swap is needed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved_by_target",
        "approved_by_admin",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "target_response": {
      "type": "string",
      "description": "Target guard's response message"
    },
    "target_responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string",
      "description": "Admin who approved"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "requesting_guard_id",
    "target_guard_id",
    "original_shift_id",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.requesting_guard_id": "{{user.id}}"
        },
        {
          "data.target_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.requesting_guard_id": "{{user.id}}"
        },
        {
          "data.target_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.requesting_guard_id": "{{user.id}}"
        },
        {
          "data.target_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}