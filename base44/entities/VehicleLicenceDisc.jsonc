{
  "name": "VehicleLicenceDisc",
  "type": "object",
  "description": "South African vehicle licence disc scanned via the document scanner. TENANT SCOPE: customer_id/reseller_id are stamped at creation from the scanning user's authoritative tenant; discs (which carry owner/vehicle PII) are readable by the scanner, their tenant and platform/reseller oversight only \u2014 never cross-tenant.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "registration_number": {
      "type": "string"
    },
    "vin": {
      "type": "string",
      "description": "Vehicle Identification Number / chassis"
    },
    "engine_number": {
      "type": "string"
    },
    "licence_number": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "colour": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "raw_scan_json": {
      "type": "string",
      "description": "Complete raw barKoder formattedJSON"
    },
    "photo_url": {
      "type": "string",
      "description": "Disc photo if available"
    },
    "scan_document_type": {
      "type": "string"
    },
    "scan_barcode_type": {
      "type": "string"
    },
    "scan_sdk_version": {
      "type": "string"
    },
    "scan_parser_used": {
      "type": "string"
    },
    "scan_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scanned_by_id": {
      "type": "string"
    },
    "scanned_by_name": {
      "type": "string"
    },
    "related_visitor_id": {
      "type": "string",
      "description": "Visitor record this disc was scanned for, if any"
    }
  },
  "required": [
    "registration_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.scanned_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.scanned_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}