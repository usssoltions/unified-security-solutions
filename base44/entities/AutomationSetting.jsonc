{
  "name": "AutomationSetting",
  "type": "object",
  "properties": {
    "monitor_overdue_patrols": {
      "type": "boolean",
      "default": false,
      "description": "Enable overdue patrol monitoring automation"
    },
    "monitor_missed_clockins": {
      "type": "boolean",
      "default": false,
      "description": "Enable missed clock-in monitoring automation"
    },
    "monitor_low_battery": {
      "type": "boolean",
      "default": false,
      "description": "Enable low battery monitoring automation"
    },
    "generate_scheduled_patrols": {
      "type": "boolean",
      "default": false,
      "description": "Enable automatic scheduled patrol generation"
    },
    "send_shift_reminders": {
      "type": "boolean",
      "default": false,
      "description": "Enable shift reminder emails (sent once per shift, 2 hours before start)"
    },
    "report_daily_activity": {
      "type": "boolean",
      "default": true,
      "description": "Enable the automated Daily Activity Report. When disabled, sendDailyActivityReport sends nothing."
    },
    "report_shift_reports": {
      "type": "boolean",
      "default": true,
      "description": "Enable automated start/end-of-shift reports (sendShiftEndNotification + AutoReportGenerator). When disabled, no shift report is generated or emailed."
    },
    "report_weekly_analysis": {
      "type": "boolean",
      "default": true,
      "description": "Enable the automated Weekly Analysis Report."
    },
    "report_monthly_comparison": {
      "type": "boolean",
      "default": true,
      "description": "Enable the automated Monthly Comparison Report."
    },
    "report_incident_alerts": {
      "type": "boolean",
      "default": true,
      "description": "Enable real-time critical incident alert emails (monitorHighPriorityIncidents). When disabled, critical incidents do not trigger alert emails."
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}