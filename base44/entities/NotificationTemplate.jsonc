{
  "name": "NotificationTemplate",
  "type": "object",
  "description": "Configurable notification templates per module. Each template defines the subject/body for a specific event_key and channel. Templates support customer branding placeholders. Versioned for assessment history integrity. VERIFIED (2026-09-21): message rendering resolves branding server-side (resolveCommunicationBrand / buildBrandedEmail / buildBrandedTelegram); this entity holds optional per-tenant overrides. TENANT ISOLATION: the reseller_id branches are reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every sibling customer's template content to every user under the same reseller (confirmed cross-customer defect class 2026-09-21).",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "module_key": {
      "type": "string",
      "description": "SECURITY, ESTATE, MEDICAL, PLATFORM"
    },
    "event_key": {
      "type": "string",
      "description": "PANIC_ACTIVATED, INCIDENT_CREATED, APPOINTMENT_CONFIRMED, SESSION_COMPLETED, etc."
    },
    "name": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "in_app",
        "push",
        "telegram"
      ]
    },
    "subject_template": {
      "type": "string"
    },
    "body_template": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "event_key",
    "channel",
    "body_template"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}