{
  "name": "WhatsAppContact",
  "type": "object",
  "description": "PLATFORM-SHARED WhatsApp contact directory (role-tagged operational contacts used by dispatchers/supervisors to compose wa.me notification links). VERIFIED 2026-09-21: contains NO customer, site or tenant-owned data \u2014 it is the platform's own contact directory, consumed via src/lib/whatsapp.js by tenant operational users, so read is deliberately OPEN (this app requires login app-wide, so open = authenticated users only, never anonymous). All WRITE operations are platform-admin-only. If this directory ever becomes tenant-specific, add customer_id/reseller_id and apply the standard tenant read pattern.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name / role"
    },
    "number": {
      "type": "string",
      "description": "WhatsApp number, e.g. +27831234567"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "supervisor",
        "management",
        "dispatcher"
      ],
      "default": "admin"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "user_condition": {
            "admin_level": "reseller"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}