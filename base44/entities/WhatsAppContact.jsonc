{
  "name": "WhatsAppContact",
  "type": "object",
  "description": "TENANT-SCOPED WhatsApp admin contact directory (role-tagged operational contacts used by dispatchers/supervisors to compose wa.me notification links). Each contact belongs to ONE customer (customer_id stamped server-side or by the tenant administrator's authenticated session); a tenant reads and manages ONLY its own contacts, and a new customer starts with an empty directory \u2014 no customer ever inherits another customer's contacts. Legacy pre-tenant records carry no customer_id and are readable only by the platform (or their creator) \u2014 never by other tenants. Consumed via src/lib/whatsapp.js by tenant operational users. WRITE operations: the contact's own tenant administrators and platform administration only.",
  "properties": {
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tenant ownership. Null = legacy platform-managed record (platform/creator read only)."
    },
    "reseller_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "description": "Contact name / role"
    },
    "number": {
      "type": "string",
      "description": "WhatsApp number, e.g. +27831234567"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "supervisor",
        "management",
        "dispatcher"
      ],
      "default": "admin"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "user_condition": {
            "admin_level": "reseller"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": null
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    }
  }
}