{
  "name": "Visitor",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "visitor_name": {
      "type": "string"
    },
    "surname": {
      "type": "string",
      "description": "Visitor surname (required for expected visitors)"
    },
    "visitor_entry_type": {
      "type": "string",
      "enum": [
        "vehicle",
        "pedestrian"
      ],
      "description": "Whether this expected visitor arrives by vehicle or on foot. Determines whether vehicle_registration is required."
    },
    "visitor_id_number": {
      "type": "string",
      "description": "SA ID number (from licence or manual). Mandatory for expected visitors."
    },
    "visitor_phone": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "destination": {
      "type": "string",
      "description": "Destination selected by the resident from the configured Destinations. Mandatory for expected visitors; shown to the guard on entry."
    },
    "expected_date": {
      "type": "string",
      "format": "date",
      "description": "Date the visitor is expected to arrive."
    },
    "expected_arrival_time": {
      "type": "string",
      "description": "Expected arrival time (HH:MM)."
    },
    "first_names": {
      "type": "string"
    },
    "initials": {
      "type": "string"
    },
    "driver_licence_number": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_classes": {
      "type": "string",
      "description": "Comma-separated vehicle class / code list"
    },
    "restrictions": {
      "type": "string"
    },
    "prdp": {
      "type": "string"
    },
    "licence_status": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "pre_registered",
        "unexpected",
        "contractor",
        "delivery"
      ],
      "default": "pre_registered"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "entered",
        "exited",
        "expired"
      ],
      "default": "pending"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "otp_code": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "id_scan_url": {
      "type": "string",
      "description": "Scanned ID / driver's licence photograph (file URL)"
    },
    "photo_url": {
      "type": "string",
      "description": "Person/visitor photo"
    },
    "scan_thumbnail_url": {
      "type": "string",
      "description": "Generated thumbnail of the scanned photo"
    },
    "scan_document_type": {
      "type": "string",
      "description": "Resolved scan profile id"
    },
    "scan_barcode_type": {
      "type": "string"
    },
    "scan_sdk_version": {
      "type": "string"
    },
    "scan_parser_used": {
      "type": "string"
    },
    "scan_profile": {
      "type": "string"
    },
    "scan_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scan_raw_json": {
      "type": "string",
      "description": "Complete raw barKoder formattedJSON preserved verbatim"
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "exited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "visitor_name",
    "resident_id",
    "visit_type"
  ]
}