{
  "name": "Visitor",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "visitor_name": {
      "type": "string"
    },
    "surname": {
      "type": "string"
    },
    "visitor_entry_type": {
      "type": "string",
      "enum": [
        "vehicle",
        "pedestrian"
      ]
    },
    "visitor_id_number": {
      "type": "string"
    },
    "visitor_phone": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "expected_date": {
      "type": "string",
      "format": "date"
    },
    "expected_arrival_time": {
      "type": "string"
    },
    "first_names": {
      "type": "string"
    },
    "initials": {
      "type": "string"
    },
    "driver_licence_number": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_classes": {
      "type": "string"
    },
    "restrictions": {
      "type": "string"
    },
    "prdp": {
      "type": "string"
    },
    "licence_status": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "pre_registered",
        "unexpected",
        "contractor",
        "delivery"
      ],
      "default": "pre_registered"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "entered",
        "exited",
        "expired"
      ],
      "default": "pending"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "otp_code": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "id_scan_url": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "scan_thumbnail_url": {
      "type": "string"
    },
    "scan_document_type": {
      "type": "string"
    },
    "scan_barcode_type": {
      "type": "string"
    },
    "scan_sdk_version": {
      "type": "string"
    },
    "scan_parser_used": {
      "type": "string"
    },
    "scan_profile": {
      "type": "string"
    },
    "scan_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scan_raw_json": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "exited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "visitor_name",
    "resident_id",
    "visit_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}