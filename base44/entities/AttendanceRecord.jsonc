{
  "name": "AttendanceRecord",
  "type": "object",
  "description": "Attendance Register module: One visit = one record. Stores historical snapshots of all fields at visit time so edits to the worker profile do not rewrite history. Every record carries its own fresh electronic signature (one attendance = one signature). ID-DOCUMENT PHOTOS: each record retains a visit-level snapshot of the ID-document photos used for that registration (the newly captured photos, or the worker's current photos when no new capture was made) so the visit itself preserves its identity evidence independently of later profile changes. TENANT ACCESS PATTERN: this entity deliberately carries NO {{user.data.*}} RLS rules \u2014 session tokens do not reliably expose custom User fields (customer_id/reseller_id), so template-based tenant scoping is unproven on this platform. ALL tenant reads/writes go through the attendanceAccess backend function, which resolves the caller's tenant server-side from their User record (the same proven pattern as getTenantUsers), enforces the ATTENDANCE_REGISTER module licence, and fails closed for unauthorized roles. Direct client access below is restricted to platform admins only \u2014 Customer A can never reach Customer B's records or signatures.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string",
      "description": "Reference to AttendanceWorker profile"
    },
    "attendance_date": {
      "type": "string",
      "format": "date",
      "description": "Date of visit YYYY-MM-DD"
    },
    "attendance_time": {
      "type": "string",
      "description": "HH:MM local time"
    },
    "attendance_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Exact ISO timestamp of attendance"
    },
    "surname_snapshot": {
      "type": "string"
    },
    "initials_snapshot": {
      "type": "string"
    },
    "id_number_snapshot": {
      "type": "string"
    },
    "id_type_snapshot": {
      "type": "string"
    },
    "company_snapshot": {
      "type": "string"
    },
    "job_description_snapshot": {
      "type": "string"
    },
    "cellphone_snapshot": {
      "type": "string"
    },
    "medical_centre": {
      "type": "string"
    },
    "additional_information": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string"
    },
    "id_photo_front_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Visit snapshot of the ID-document FRONT photo used for this registration (newly captured photo, else the worker's current front photo when available)."
    },
    "id_photo_back_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Visit snapshot of the ID-document BACK photo used for this registration (newly captured photo, else the worker's current back photo when available)."
    },
    "signature_data_url": {
      "type": "string",
      "description": "Base64 PNG of the electronic signature captured for THIS attendance"
    },
    "captured_by_id": {
      "type": "string"
    },
    "captured_by_name": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "worker_id",
    "attendance_date",
    "id_number_snapshot",
    "surname_snapshot"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}