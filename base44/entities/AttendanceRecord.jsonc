{
  "name": "AttendanceRecord",
  "type": "object",
  "description": "Attendance Register module: One visit = one record. Stores historical snapshots of all fields at visit time so edits to the worker profile do not rewrite history. Every record carries its own fresh electronic signature (one attendance = one signature) which is NEVER modified by any edit. SIGNATURE STATUS: signature_status is stamped SERVER-SIDE by the attendanceAccess gateway \u2014 'signed' (signature captured at registration or later against the visit), 'pending' (deferred save: a real attendance record saved without a signature through the 'Save \u2014 Sign Later' flow, only when the customer's deferred-signature setting is enabled), 'needs_review' (legacy record saved before signature status existed with no signature stored \u2014 flagged for review, never silently classified as deferred). signature_captured_at / signature_captured_by_id / signature_captured_by_name are set SERVER-SIDE at the moment the signature is captured (at registration or later via the sign_pending action) and never edited afterwards. A signature is attached to exactly ONE attendance visit \u2014 profile signatures are never stored or reused. ID-DOCUMENT PHOTOS: each record retains a visit-level snapshot of the ID-document photos used for that registration (the newly captured photos, or the worker's current photos when no new capture was made). EDITS: authorised administrators may correct snapshot details or attach/replace visit photos through the attendanceAccess gateway; the first edit freezes original_snapshot and every edit appends an attributed, reasoned entry to edit_history (plus a PlatformAuditLog row). Verified corrections are also applied to the worker profile matched by customer + ID number (updated in place, or created when none exists) so the person is searchable with the corrected details; other workers and other attendance records are never changed. Signature, attendance date/time and worker link are never editable. TENANT ACCESS PATTERN: this entity deliberately carries NO {{user.data.*}} RLS rules \u2014 ALL tenant reads/writes go through the attendanceAccess backend function, which resolves the caller's tenant server-side, enforces the ATTENDANCE_REGISTER module licence, and fails closed for unauthorized roles. Direct client access below is restricted to platform admins only.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string",
      "description": "Reference to AttendanceWorker profile"
    },
    "attendance_date": {
      "type": "string",
      "format": "date",
      "description": "Date of visit YYYY-MM-DD"
    },
    "attendance_time": {
      "type": "string",
      "description": "HH:MM local time"
    },
    "attendance_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Exact ISO timestamp of attendance"
    },
    "surname_snapshot": {
      "type": "string"
    },
    "initials_snapshot": {
      "type": "string"
    },
    "id_number_snapshot": {
      "type": "string"
    },
    "id_type_snapshot": {
      "type": "string"
    },
    "company_snapshot": {
      "type": "string"
    },
    "job_description_snapshot": {
      "type": "string"
    },
    "cellphone_snapshot": {
      "type": "string"
    },
    "medical_centre": {
      "type": "string"
    },
    "additional_information": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string"
    },
    "signature_status": {
      "type": "string",
      "enum": [
        "signed",
        "pending",
        "needs_review"
      ],
      "description": "INTERNAL server-stamped state: signed = this visit carries its own signature; pending = deferred save awaiting a later signature; needs_review = legacy unsigned record flagged for review. Derived server-side when absent."
    },
    "signature_captured_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "INTERNAL server-stamped instant the signature was captured (at registration, or later for a deferred visit)."
    },
    "signature_captured_by_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL server-stamped authenticated user who captured the signature."
    },
    "signature_captured_by_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL server-stamped display name of the user who captured the signature."
    },
    "id_photo_front_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Visit snapshot of the ID-document FRONT photo used for this registration."
    },
    "id_photo_back_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Visit snapshot of the ID-document BACK photo used for this registration."
    },
    "id_photo_source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "captured_this_visit",
        "on_file",
        "attached_by_edit",
        null
      ],
      "description": "Where the visit photos came from: captured during this registration, the worker's photos already on file, or attached later by an administrator edit."
    },
    "id_photo_captured_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "When the visit photos were captured/attached (when known)."
    },
    "id_photo_captured_by_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "id_photo_captured_by_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature_data_url": {
      "type": "string",
      "description": "Base64 PNG of the electronic signature captured for THIS attendance \u2014 never modified by edits, never reused from another visit."
    },
    "captured_by_id": {
      "type": "string"
    },
    "captured_by_name": {
      "type": "string"
    },
    "original_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "description": "Frozen copy of the editable fields as originally registered, stored on the FIRST edit and never overwritten."
    },
    "edit_history": {
      "type": "array",
      "default": [],
      "description": "Append-only, attributed edit log. Each entry records who edited, when, why, and every changed field (from \u2192 to).",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "editor_id": {
            "type": "string"
          },
          "editor_name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "changes": {
            "type": "object",
            "description": "{ field: { from, to } }"
          },
          "applied_to_worker": {
            "type": "boolean",
            "default": false
          },
          "worker_profile_action": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the edit did to the worker profile matched by customer + ID number: updated_linked | updated_matching | corrected_linked | created | in_sync | skipped."
          },
          "worker_profile_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Worker profile the corrected details were applied to."
          }
        }
      }
    },
    "last_edited_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_edited_by_name": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "customer_id",
    "worker_id",
    "attendance_date",
    "id_number_snapshot",
    "surname_snapshot"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}