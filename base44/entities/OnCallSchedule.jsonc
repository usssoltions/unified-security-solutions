{
  "name": "OnCallSchedule",
  "type": "object",
  "description": "On-call responder schedule. TENANT ISOLATION (was world-readable \u2014 read:null, fixed 2026-09-21): reads are now customer-scoped with a RESELLER-ADMIN-only reseller_id branch (admin_level 'reseller'); the on-call guard, their backup and the creator see their own records; platform admins retain oversight. Write operations remain platform-administered exactly as before.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "armed_response",
        "k9_unit",
        "medical_response",
        "fire_response",
        "technical_support",
        "supervisor",
        "general"
      ],
      "default": "general"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "priority_level": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "1=highest priority, 5=backup"
    },
    "coverage_area": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Site IDs covered"
    },
    "contact_number": {
      "type": "string"
    },
    "backup_guard_id": {
      "type": "string"
    },
    "backup_guard_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "active",
        "responded",
        "completed",
        "unavailable"
      ],
      "default": "scheduled"
    },
    "response_time_minutes": {
      "type": "number",
      "description": "Expected response time"
    },
    "actual_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alarm_id": {
            "type": "string"
          },
          "responded_at": {
            "type": "string"
          },
          "completed_at": {
            "type": "string"
          },
          "response_time": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "guard_id",
    "specialty",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "data.backup_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}