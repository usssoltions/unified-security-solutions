{
  "name": "StayAwakeLog",
  "type": "object",
  "description": "Stay-awake (fatigue) check log \u2014 SERVER-AUTHORITATIVE (rebuilt 2026-09-22). Every prompt is ISSUED by the stayAwakeService gateway from the monitor sweep (runAllMonitors tick): the ACTIVE, CLOCKED-IN shift, guard, site, customer and reseller are resolved server-side; each prompt carries a unique server-generated challenge_id and expires_at; acknowledgement is validated and stamped by the same gateway (response time, status, guard and shift are NEVER client-supplied). OUTCOME TRANSITIONS ARE ATOMIC CAS UPDATES (2026-09-23): acknowledged matches {id, status 'sent', guard_id, deadline not expired}; missed matches {id, status 'sent', STORED deadline expired} and stamps missed_at server-side \u2014 a concurrent worker that loses the race updates zero rows and escalates NOTHING, so each challenge produces exactly one outcome and exactly one escalation per recipient (deterministic idempotency keys on every channel). LATE/OFFLINE RULE: acknowledgements are valid only before the server-issued deadline; after expiry the missed outcome stands and the cycle resets with the next scheduled prompt. GATEWAY-ONLY WRITES: create/update/delete are restricted to platform administration by RLS \u2014 clients can only READ (guard sees own logs; customer staff see their tenant's; reseller admins their reseller's; platform retains oversight). State machine: sent \u2192 acknowledged (own guard, before expiry, idempotent) | missed (atomic timeout \u2192 tenant-scoped escalation, deduplicated) | cancelled (shift ended / clock-out / reassignment / Stay Awake disabled before expiry \u2014 never escalated).",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership \u2014 stamped server-side from the authoritative shift"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership \u2014 stamped server-side from the authoritative shift"
    },
    "guard_id": {
      "type": "string",
      "description": "Guard User id \u2014 server-resolved from the active shift, never client-supplied"
    },
    "guard_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string",
      "description": "Active shift id \u2014 server-resolved; prompts are only issued for shifts with a clock-in"
    },
    "site_id": {
      "type": "string",
      "description": "Site stamped server-side from the shift (escalation control-room narrowing uses it)"
    },
    "site_name": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string",
      "description": "Unique server-generated challenge/event id for this prompt (crypto.randomUUID)"
    },
    "alert_time": {
      "type": "string",
      "format": "date-time",
      "description": "Server-issued prompt timestamp"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-issued acknowledgement deadline \u2014 expired prompts cannot be acknowledged as current"
    },
    "response_time": {
      "type": "string",
      "format": "date-time",
      "description": "Server-stamped acknowledgement time (gateway only)"
    },
    "response_method": {
      "type": "string",
      "enum": [
        "button",
        "pin",
        "biometric"
      ]
    },
    "missed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-stamped missed-transition time \u2014 set ONLY by the atomic CAS transition (id + status 'sent' + stored deadline expired), never by clients and never re-stamped."
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "acknowledged",
        "missed",
        "cancelled"
      ],
      "default": "sent",
      "description": "sent (issued, awaiting response) \u2192 acknowledged | missed (atomic timeout transition, escalated once) | cancelled (shift no longer active at check time, or Stay Awake disabled \u2014 never escalated)"
    },
    "response_time_seconds": {
      "type": "number",
      "description": "Computed server-side at acknowledgement ((response_time - alert_time)/1000)"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "FIXTURE MARKER: true only for lifecycle-test fixtures (stayAwakeSelfTest, isolated test tenant, propagated from is_test shifts). Fixture prompts/escalations NEVER trigger native push or Telegram delivery to real devices; their audited emails are additionally rewritten to the test mailbox by the delivery guard. Never set by the live sweep path for a real shift."
    }
  },
  "required": [
    "guard_id",
    "shift_id",
    "alert_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}