{
  "name": "AttendanceDropdownOption",
  "type": "object",
  "description": "Attendance Register module: Configurable dropdown options for Medical Centre and Assessment Type. The fixed official options are seeded server-side (idempotently) by the attendanceAccess gateway and must never be altered. Ordinary attendance staff CANNOT create, edit or deactivate options \u2014 option management is restricted to authorized admins (platform / reseller / customer admins) through the attendanceAccess gateway, which also enforces the ATTENDANCE_REGISTER module licence. Deactivating preserves historical records. TENANT ACCESS PATTERN: no {{user.data.*}} RLS rules \u2014 all tenant access goes through the attendanceAccess backend function (server-side tenant resolution, same proven pattern as getTenantUsers). Direct client access below is platform-admin-only.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "option_type": {
      "type": "string",
      "enum": [
        "medical_centre",
        "assessment_type"
      ],
      "description": "Which dropdown this option belongs to"
    },
    "label": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "option_type",
    "label"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}