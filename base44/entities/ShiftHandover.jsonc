{
  "name": "ShiftHandover",
  "type": "object",
  "description": "Start-of-shift / shift handover report. TENANT ISOLATION (was world-readable \u2014 read:null, fixed 2026-09-21): reads are now customer-scoped with a RESELLER-ADMIN-only reseller_id branch (admin_level 'reseller'); the outgoing and incoming guards and the creator always see their own reports; platform admins retain oversight. New records carry customer_id/reseller_id (stamped at creation); legacy unscoped records remain visible via own-record branches and to platform admins.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access"
    },
    "shift_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "outgoing_guard_id": {
      "type": "string"
    },
    "outgoing_guard_name": {
      "type": "string"
    },
    "incoming_guard_id": {
      "type": "string"
    },
    "incoming_guard_name": {
      "type": "string"
    },
    "handover_time": {
      "type": "string",
      "format": "date-time"
    },
    "site_status": {
      "type": "object",
      "properties": {
        "all_secure": {
          "type": "boolean",
          "default": true
        },
        "gates_locked": {
          "type": "boolean"
        },
        "alarms_armed": {
          "type": "boolean"
        },
        "lights_functional": {
          "type": "boolean"
        },
        "cameras_operational": {
          "type": "boolean"
        },
        "perimeter_secure": {
          "type": "boolean"
        }
      }
    },
    "incidents_during_shift": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "incident_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "maintenance_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "urgency": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      },
      "default": []
    },
    "visitors_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "key_activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "outstanding_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "due_by": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "weather_conditions": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "incoming_guard_signature": {
      "type": "string"
    },
    "outgoing_guard_signature": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "media_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "shift_id",
    "site_id",
    "outgoing_guard_id",
    "handover_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.outgoing_guard_id": "{{user.id}}"
        },
        {
          "data.incoming_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.outgoing_guard_id": "{{user.id}}"
        },
        {
          "data.incoming_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.outgoing_guard_id": "{{user.id}}"
        },
        {
          "data.incoming_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}