{
  "name": "DocumentScan",
  "type": "object",
  "description": "Central audit trail + scan history for every document scan across USS Guard. One record per accepted/failed scan. TENANT ISOLATION: customer_id/reseller_id stamped from the scanning user's authoritative tenant; scans (which carry personal document data) are readable by the scanner, their tenant and oversight \u2014 never cross-customer. The reseller_id branch is RESELLER-ADMIN-only (admin_level 'reseller'). Legacy unscoped records remain readable by their scanner and platform admins only.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "user_id": {
      "type": "string",
      "description": "App user who performed the scan"
    },
    "user_name": {
      "type": "string"
    },
    "guard_id": {
      "type": "string",
      "description": "Badge number if a guard"
    },
    "estate_name": {
      "type": "string"
    },
    "device": {
      "type": "string",
      "description": "User agent / device descriptor"
    },
    "gps_lat": {
      "type": "number"
    },
    "gps_lng": {
      "type": "number"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "drivers_licence",
        "vehicle_disc",
        "sa_id",
        "passport_mr",
        "qr",
        "generic_barcode",
        "unknown"
      ],
      "description": "Resolved document profile"
    },
    "barcode_type": {
      "type": "string",
      "description": "e.g. PDF417, QR, DataMatrix, Aztec, Code128"
    },
    "success": {
      "type": "boolean",
      "default": false
    },
    "failure_reason": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "sdk_version": {
      "type": "string",
      "description": "Scanner engine version"
    },
    "parser_used": {
      "type": "string",
      "description": "SADL / QR / BARCODE / MRZ"
    },
    "profile": {
      "type": "string",
      "description": "Scan profile id used"
    },
    "raw_json": {
      "type": "string",
      "description": "Complete raw formattedJSON preserved verbatim"
    },
    "photo_url": {
      "type": "string",
      "description": "Extracted document/person photo (file URL)"
    },
    "mapped_summary": {
      "type": "string",
      "description": "Short human-readable summary of mapped fields"
    },
    "related_id": {
      "type": "string",
      "description": "Entity record this scan produced/updated (e.g. Visitor id)"
    },
    "related_entity": {
      "type": "string",
      "description": "e.g. Visitor, VehicleLicenceDisc"
    },
    "caller_page": {
      "type": "string",
      "description": "Which page/module invoked the scanner"
    }
  },
  "required": [
    "document_type",
    "time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "admin_level": "platform"
      }
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}