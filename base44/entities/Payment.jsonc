{
  "name": "Payment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation. Stamped at creation from the paying resident's authoritative tenant."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "levy",
        "venue_booking",
        "order",
        "laundry",
        "service",
        "fine",
        "other"
      ]
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "payfast_payment_id": {
      "type": "string"
    },
    "payfast_token": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "related_entity": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "payment_type",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.resident_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}