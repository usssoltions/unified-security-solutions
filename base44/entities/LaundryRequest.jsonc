{
  "name": "LaundryRequest",
  "type": "object",
  "description": "Estate laundry pickup/delivery request. TENANT ACCESS: every tenant read/write goes through the estateAccess backend gateway (resident self-service; vendor self-service for own requests; manager oversight). Direct client access is restricted to platform admins by RLS. NO PAYMENT FUNCTIONALITY \u2014 cost fields are display/estimate only; the app never collects payment.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ownership for multi-tenant isolation."
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ownership for reseller-scoped oversight access."
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "pickup_date": {
      "type": "string",
      "format": "date"
    },
    "pickup_time_slot": {
      "type": "string"
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_time_slot": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "service": {
            "type": "string",
            "enum": [
              "wash",
              "dry_clean",
              "iron",
              "wash_iron"
            ]
          }
        }
      },
      "default": []
    },
    "special_instructions": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "picked_up",
        "processing",
        "ready",
        "delivered",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "estimated_cost": {
      "type": "number"
    },
    "final_cost": {
      "type": "number"
    }
  },
  "required": [
    "resident_id",
    "pickup_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}