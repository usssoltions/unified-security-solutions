{
  "name": "AttendanceWorker",
  "type": "object",
  "description": "Attendance Register module: Permanent Worker/Patient profile. Deduplication key is id_number + customer_id. Identification-document images belong here, not per attendance record. TENANT ACCESS PATTERN: this entity deliberately carries NO {{user.data.*}} RLS rules \u2014 session tokens do not reliably expose custom User fields (customer_id/reseller_id), so template-based tenant scoping is unproven on this platform. ALL tenant reads/writes go through the attendanceAccess backend function, which resolves the caller's tenant server-side from their User record (the same proven pattern as getTenantUsers), enforces the ATTENDANCE_REGISTER module licence, and fails closed for unauthorized roles. Direct client access below is restricted to platform admins only \u2014 Customer A can never reach Customer B's workers.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "surname": {
      "type": "string"
    },
    "initials": {
      "type": "string"
    },
    "first_names": {
      "type": "string",
      "description": "Full first names. Never populated from a truncated barcode decode \u2014 unreliable scanned values are left blank and flagged (first_names_needs_review) rather than stored."
    },
    "id_number": {
      "type": "string",
      "description": "SA ID / Passport / Driver's Licence number \u2014 deduplication key within tenant"
    },
    "id_type": {
      "type": "string",
      "enum": [
        "sa_id",
        "drivers_licence",
        "passport",
        "other"
      ],
      "default": "sa_id"
    },
    "company": {
      "type": "string",
      "description": "Company / Customer"
    },
    "job_description": {
      "type": "string"
    },
    "cellphone": {
      "type": "string"
    },
    "first_names_needs_review": {
      "type": "boolean",
      "default": false,
      "description": "INTERNAL: a truncated barcode-decode fragment was found in first_names and cleared during the 2026-10-12 scan-fragment repair. The field is blank until a verified complete value is entered from the document \u2014 no name is ever invented for it."
    },
    "repair_history": {
      "type": "array",
      "default": [],
      "description": "Append-only audit of scan-integrity repairs applied to this profile: what was cleared, when, by whom, why, and the previous unreliable value (kept within the record's own audit for traceability).",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "by_name": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "previous_value": {
            "type": "string",
            "description": "The unreliable value that was cleared."
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "id_front_url": {
      "type": "string",
      "description": "Identification document front image URL"
    },
    "id_back_url": {
      "type": "string",
      "description": "Identification document back image URL (cards)"
    },
    "id_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "id_captured_by_id": {
      "type": "string"
    },
    "id_captured_by_name": {
      "type": "string"
    },
    "id_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "created_by_name": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "surname",
    "id_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}