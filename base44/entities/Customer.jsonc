{
  "name": "Customer",
  "type": "object",
  "description": "A customer/tenant organization (security company, estate, medical practice, factory, business park, corporate). May belong to a reseller or be directly platform-managed. TENANT ISOLATION: customer admins read their OWN organisation via the id == user.data.customer_id branch; the reseller_id branch is RESELLER-ADMIN-only (admin_level 'reseller') \u2014 previously every user under a reseller matched it and could read/update every sibling customer's organisation record (confirmed cross-customer defect 2026-09-21). Platform admins retain full access via the built-in admin role.",
  "properties": {
    "name": {
      "type": "string"
    },
    "app_name": {
      "type": "string",
      "description": "Customer-facing application / workspace name (white-label override) shown in branded emails and customer-facing screens. Falls back to the reseller's app_name, then the platform default. Distinct from the trading name."
    },
    "legal_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ID if this customer belongs to a reseller. Null for direct platform-managed customers."
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "security",
        "estate",
        "medical",
        "industrial",
        "business_park",
        "corporate",
        "other"
      ],
      "default": "security"
    },
    "device_limit": {
      "type": "number",
      "description": "COMPULSORY for every NEW customer \u2014 enforced server-side by the customerAccess gateway (integer, minimum 1; a customer cannot be created without a valid device limit). Authoritative customer-wide licensed-device allowance based on PHYSICAL APP INSTALLATIONS (not users): one installation consumes one slot regardless of how many users log into it, and logging out never frees a slot. Null ONLY for legacy customers created before this field existed \u2014 these are flagged 'Device allowance requires configuration' (never silently limited); once a platform administrator configures it, enforcement is authoritative and transaction-safe (deviceAccess gateway). Only platform-level administrators may change it (audited: customer.device_limit_changed); a customer can never increase its own allowance."
    },
    "device_lock_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL registration-mutex token held by the deviceAccess gateway while counting/registering devices under the licence limit (CAS on this field guarantees two simultaneous registrations can never both take the final slot). Never exposed to any UI; never used for authorization."
    },
    "device_lock_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Expiry of the device registration mutex token \u2014 a crashed holder's lock is stealable after this instant (stale-lock recovery). Internal only."
    },
    "operational_user_limit": {
      "type": "number",
      "description": "COMPULSORY for every NEW customer \u2014 the SECOND, fully INDEPENDENT customer entitlement (enforced server-side by the customerAccess/inviteTenantUser gateways; integer, minimum 1; a customer cannot be created without it). Authoritative customer-wide licensed OPERATIONAL USER allowance: users who actually operate the security/access-control system (operational roles from the authoritative role catalogue \u2014 e.g. Security Guard, Dispatcher, Control Room Operator) each consume one slot, as does every VALID PENDING operational-user invitation (no quota bypass by mass-inviting). Administrative roles (Customer Administrator etc.) do NOT consume a slot. DELIBERATELY SEPARATE from device_limit: one counts people, the other counts physical app installations; neither affects the other. Null ONLY for legacy customers created before this field existed \u2014 these are flagged 'Operational user allowance requires configuration' (never silently limited); once a platform administrator configures it, enforcement is authoritative and transaction-safe (per-customer CAS mutex on user_lock_token). Only platform-level administrators may change it (audited: customer.operational_user_limit_changed); a customer can never increase its own allowance."
    },
    "user_lock_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL operational-user-slot mutex token held while counting/creating operational users and invitations under the licence limit (CAS on this field guarantees two simultaneous invitations can never both take the final slot). Never exposed to any UI; never used for authorization."
    },
    "user_lock_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Expiry of the operational-user-slot mutex token \u2014 a crashed holder's lock is stealable after this instant (stale-lock recovery). Internal only."
    },
    "guard_default_landing": {
      "type": "string",
      "description": "Optional customer-configurable GUARD DEFAULT LANDING MODULE (page key, e.g. 'access_control'). When set, a guard of THIS customer lands directly on that module after login / app reopen / session restore instead of the generic guard role home \u2014 no intermediate dashboard tap. Strictly fail-closed: the override only applies when the guard's role permits the page AND the customer's module entitlements enable it (isPageModuleEnabled); every other customer keeps its existing landing behaviour. Unset/null = unchanged landing. No licensing, scoping or security semantics \u2014 it changes WHICH authorised page is shown first, never WHAT a guard may access."
    },
    "logo_url": {
      "type": "string",
      "description": "Customer logo file URL. Customer-level white-label branding override \u2014 wins over the reseller logo when set."
    },
    "logo_background": {
      "type": "string",
      "enum": [
        "auto",
        "white",
        "transparent"
      ],
      "description": "Container treatment behind the uploaded logo only \u2014 the logo image itself is never modified. Stored as a customer OVERRIDE only \u2014 inherited values are never copied into the customer record."
    },
    "primary_color": {
      "type": "string",
      "description": "Customer primary brand colour (hex). Customer-level override \u2014 wins over the reseller colour when set."
    },
    "accent_color": {
      "type": "string",
      "description": "Customer accent / action colour (hex). Customer-level override \u2014 wins over the reseller colour when set."
    },
    "pwa_slug": {
      "type": "string",
      "description": "PUBLIC, unique, immutable-once-assigned install slug for this customer's PWA. COSMETIC ONLY \u2014 the slug never grants tenant access. Uniqueness and immutability are enforced server-side by manageCustomerBranding."
    },
    "pwa_app_name": {
      "type": "string",
      "description": "Installed PWA app name override (launcher label). Blank falls back to the effective app/business name \u2192 reseller \u2192 platform default."
    },
    "pwa_short_name": {
      "type": "string",
      "description": "Installed PWA short name (limited-space launcher label, ~12 characters). Blank is derived from the PWA app name."
    },
    "pwa_icon_192_url": {
      "type": "string",
      "description": "Dedicated square 192x192 PWA launcher icon URL. Blank falls back to pwa_icon_512_url, then the customer logo, then the reseller/platform icon."
    },
    "pwa_icon_512_url": {
      "type": "string",
      "description": "Dedicated square 512x512 PWA launcher icon URL (PNG, maskable-compatible recommended)."
    },
    "pwa_background_color": {
      "type": "string",
      "description": "Installed PWA splash/background colour override (hex). Blank uses the platform neutral dark background."
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Primary contact email. Also serves as the customer-level support email in branded customer-facing text."
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "customer_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "id": "{{user.data.customer_id}}"
            },
            {
              "id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}