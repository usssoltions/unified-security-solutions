{
  "name": "Customer",
  "type": "object",
  "description": "A customer/tenant organization (security company, estate, medical practice, factory, business park, corporate). May belong to a reseller or be directly platform-managed. TENANT ISOLATION: customer admins read their OWN organisation via the id == user.data.customer_id branch; the reseller_id branch is RESELLER-ADMIN-only (admin_level 'reseller'). Platform admins retain full access via the built-in admin role.",
  "properties": {
    "name": {
      "type": "string"
    },
    "app_name": {
      "type": "string",
      "description": "Customer-facing application / workspace name (white-label override). Falls back to the reseller's app_name, then the platform default."
    },
    "legal_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ID if this customer belongs to a reseller. Null for direct platform-managed customers."
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "security",
        "estate",
        "medical",
        "industrial",
        "business_park",
        "corporate",
        "other"
      ],
      "default": "security"
    },
    "device_limit": {
      "type": "number",
      "description": "COMPULSORY for every NEW customer \u2014 authoritative customer-wide licensed-device allowance (physical installations). Null only for legacy customers. Only platform-level administrators may change it."
    },
    "device_lock_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL device registration mutex token. Never exposed to any UI."
    },
    "device_lock_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Expiry of the device registration mutex token. Internal only."
    },
    "operational_user_limit": {
      "type": "number",
      "description": "COMPULSORY for every NEW customer \u2014 authoritative licensed OPERATIONAL USER allowance, independent of device_limit. Only platform-level administrators may change it."
    },
    "user_lock_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL operational-user-slot mutex token. Never exposed to any UI."
    },
    "user_lock_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Expiry of the operational-user-slot mutex token. Internal only."
    },
    "digital_ob_enabled": {
      "type": "boolean",
      "default": false,
      "description": "PERSISTED CUSTOMER SETTING (default OFF): enables the Digital Occurrence Book extension inside Task & OB Scheduling. Server-enforced; requires the Task Scheduling module."
    },
    "guard_default_landing": {
      "type": "string",
      "description": "Optional guard default landing module page key (e.g. 'access_control'). Fail-closed: applies only when role and entitlements permit the page."
    },
    "login_tagline": {
      "type": [
        "string",
        "null"
      ],
      "description": "OPTIONAL public-safe tagline shown under the app name on the branded pre-login screen (e.g. 'Hospitality Access & Security Management' for GRID GATE). Cosmetic only \u2014 never affects authentication or tenant scope. Null = the generic platform tagline."
    },
    "logo_url": {
      "type": "string",
      "description": "Customer logo file URL. Customer-level white-label branding override \u2014 wins over the reseller logo when set."
    },
    "document_secondary_logo_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "OPTIONAL secondary logo shown on generated documents (e.g. hospitality visit reports) alongside the primary brand logo \u2014 e.g. GRID GATE primary, Grid Protection secondary. When unset, documents render exactly as before (primary brand only)."
    },
    "logo_background": {
      "type": "string",
      "enum": [
        "auto",
        "white",
        "transparent"
      ],
      "description": "Container treatment behind the uploaded logo only."
    },
    "primary_color": {
      "type": "string",
      "description": "Customer primary brand colour (hex)."
    },
    "accent_color": {
      "type": "string",
      "description": "Customer accent / action colour (hex)."
    },
    "pwa_slug": {
      "type": "string",
      "description": "PUBLIC, unique, immutable-once-assigned install slug. COSMETIC ONLY \u2014 never grants tenant access."
    },
    "pwa_app_name": {
      "type": "string"
    },
    "pwa_short_name": {
      "type": "string"
    },
    "pwa_icon_192_url": {
      "type": "string"
    },
    "pwa_icon_512_url": {
      "type": "string"
    },
    "pwa_background_color": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Primary contact email. Also the customer-level support email in branded customer-facing text."
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "customer_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "id": "{{user.data.customer_id}}"
            },
            {
              "id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}