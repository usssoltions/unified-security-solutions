{
  "name": "Customer",
  "type": "object",
  "description": "A customer/tenant organization. Can be a security company, estate, medical practice, factory, business park, or corporate client. May belong to a reseller or be directly managed by the platform (reseller_id = null).",
  "properties": {
    "name": {
      "type": "string"
    },
    "app_name": {
      "type": "string",
      "description": "Customer-facing application / workspace name (white-label override) shown in branded emails and customer-facing screens. Falls back to the reseller's app_name, then the platform default. Distinct from the trading name."
    },
    "legal_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ID if this customer belongs to a reseller. Null for direct platform-managed customers."
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "security",
        "estate",
        "medical",
        "industrial",
        "business_park",
        "corporate",
        "other"
      ],
      "default": "security"
    },
    "logo_url": {
      "type": "string",
      "description": "Customer logo file URL. Customer-level white-label branding override \u2014 wins over the reseller logo when set."
    },
    "primary_color": {
      "type": "string",
      "description": "Customer primary brand colour (hex). Customer-level override \u2014 wins over the reseller colour when set."
    },
    "accent_color": {
      "type": "string",
      "description": "Customer accent / action colour (hex). Customer-level override \u2014 wins over the reseller colour when set."
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Primary contact email. Also serves as the customer-level support email in branded customer-facing text."
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "customer_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "id": "{{user.data.customer_id}}"
            },
            {
              "id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}