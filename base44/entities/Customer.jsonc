{
  "name": "Customer",
  "type": "object",
  "description": "A customer/tenant organization (security company, estate, medical practice, factory, business park, corporate). May belong to a reseller or be directly platform-managed. TENANT ISOLATION: customer admins read their OWN organisation via the id == user.data.customer_id branch; the reseller_id branch is RESELLER-ADMIN-only (admin_level 'reseller') \u2014 previously every user under a reseller matched it and could read/update every sibling customer's organisation record (confirmed cross-customer defect 2026-09-21). Platform admins retain full access via the built-in admin role.",
  "properties": {
    "name": {
      "type": "string"
    },
    "app_name": {
      "type": "string",
      "description": "Customer-facing application / workspace name (white-label override) shown in branded emails and customer-facing screens. Falls back to the reseller's app_name, then the platform default. Distinct from the trading name."
    },
    "legal_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ID if this customer belongs to a reseller. Null for direct platform-managed customers."
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "security",
        "estate",
        "medical",
        "industrial",
        "business_park",
        "corporate",
        "other"
      ],
      "default": "security"
    },
    "logo_url": {
      "type": "string",
      "description": "Customer logo file URL. Customer-level white-label branding override \u2014 wins over the reseller logo when set."
    },
    "logo_background": {
      "type": "string",
      "enum": [
        "auto",
        "white",
        "transparent"
      ],
      "description": "Container treatment behind the uploaded logo only \u2014 the logo image itself is never modified. Stored as a customer OVERRIDE only \u2014 inherited values are never copied into the customer record."
    },
    "primary_color": {
      "type": "string",
      "description": "Customer primary brand colour (hex). Customer-level override \u2014 wins over the reseller colour when set."
    },
    "accent_color": {
      "type": "string",
      "description": "Customer accent / action colour (hex). Customer-level override \u2014 wins over the reseller colour when set."
    },
    "pwa_slug": {
      "type": "string",
      "description": "PUBLIC, unique, immutable-once-assigned install slug for this customer's PWA. COSMETIC ONLY \u2014 the slug never grants tenant access. Uniqueness and immutability are enforced server-side by manageCustomerBranding."
    },
    "pwa_app_name": {
      "type": "string",
      "description": "Installed PWA app name override (launcher label). Blank falls back to the effective app/business name \u2192 reseller \u2192 platform default."
    },
    "pwa_short_name": {
      "type": "string",
      "description": "Installed PWA short name (limited-space launcher label, ~12 characters). Blank is derived from the PWA app name."
    },
    "pwa_icon_192_url": {
      "type": "string",
      "description": "Dedicated square 192x192 PWA launcher icon URL. Blank falls back to pwa_icon_512_url, then the customer logo, then the reseller/platform icon."
    },
    "pwa_icon_512_url": {
      "type": "string",
      "description": "Dedicated square 512x512 PWA launcher icon URL (PNG, maskable-compatible recommended)."
    },
    "pwa_background_color": {
      "type": "string",
      "description": "Installed PWA splash/background colour override (hex). Blank uses the platform neutral dark background."
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Primary contact email. Also serves as the customer-level support email in branded customer-facing text."
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "customer_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "id": "{{user.data.customer_id}}"
            },
            {
              "id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}