{
  "name": "Site",
  "type": "object",
  "description": "Security site with checkpoints and patrol configuration. TENANT ACCESS PATTERN: this entity carries NO {{user.data.*}} RLS rules \u2014 ALL tenant reads/writes go through the siteAccess backend function, which resolves the caller's tenant server-side, validates site/customer/reseller scope on every operation, and fails closed with 403 for cross-tenant access. Direct client access is restricted to platform admins only.",
  "properties": {
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ID for reseller-scoped access"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "geofence_radius": {
      "type": "number",
      "default": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qr_code": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "default": "medium"
          },
          "description": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              }
            }
          }
        }
      },
      "default": []
    },
    "patrol_config": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_time": {
                "type": "string"
              },
              "end_time": {
                "type": "string"
              },
              "frequency_minutes": {
                "type": "number"
              },
              "days": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "random_timing": {
                "type": "boolean",
                "default": false,
                "description": "TRUE RANDOM PATROL TIMING: unpredictable (deterministic/idempotent per site+date) patrol times inside the window."
              },
              "patrol_count": {
                "type": "number",
                "description": "Number of patrols to generate inside the window when random_timing is on."
              },
              "min_spacing_minutes": {
                "type": "number",
                "default": 45,
                "description": "Minimum spacing between randomly-timed patrols."
              }
            }
          },
          "default": []
        },
        "duration_target_minutes": {
          "type": "number",
          "default": 30
        },
        "random_route": {
          "type": "boolean",
          "default": true
        },
        "ai_route_optimization": {
          "type": "boolean",
          "default": true
        },
        "required_checkpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "alert_before_minutes": {
          "type": "number",
          "default": 10
        },
        "escalation_after_minutes": {
          "type": "number",
          "default": 15
        },
        "supervisor_escalation": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "checklist_templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_workflow": {
      "type": "string",
      "enum": [
        "default",
        "grid_gate_hospitality"
      ],
      "default": "default",
      "description": "Site-level access-control workflow selection, never activated by branding. 'default' = existing scan/vehicle/pedestrian/QR flow; 'grid_gate_hospitality' = GRID GATE Hospitality workflow enforced server-side by finalizeAccessEntry hospitality_submit. Managed through the siteAccess gateway only."
    },
    "access_workflow_version": {
      "type": "number",
      "default": 1,
      "description": "Snapshot number stamped onto every HospitalityVisit."
    },
    "hospitality_display_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional guest-facing hotel name used in GRID GATE greetings (e.g. 'Hyatt House Sandton' for the site 'Hyatt House Sandton \u2014 Demo'). Falls back to the site name."
    },
    "hospitality_grant_lock_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL per-site grant mutex token (atomic conditional acquire) serialising hospitality admission decisions so two requests can never both commit a grant for the same person. Never exposed to UI."
    },
    "hospitality_grant_lock_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "INTERNAL expiry of the grant mutex (stale-holder recovery). A holder that lost its lock voids its own uncommitted entry (never a fabricated exit)."
    }
  },
  "required": [
    "name",
    "address",
    "client_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}