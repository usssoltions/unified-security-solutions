{
  "name": "Site",
  "type": "object",
  "description": "Security site with checkpoints and patrol configuration. TENANT ACCESS PATTERN: this entity carries NO {{user.data.*}} RLS rules \u2014 session tokens do not reliably expose custom User fields (customer_id/reseller_id), so the previous tenant-scoping rules could never match and direct client reads leaked every tenant's sites (confirmed cross-tenant defect, fixed 2026-09). ALL tenant reads/writes go through the siteAccess backend function, which resolves the caller's tenant server-side from their User record (the proven attendanceAccess/scheduledTaskAccess pattern), validates site/customer/reseller scope on every operation, and fails closed with 403 for cross-tenant access. Direct client access below is restricted to platform admins only \u2014 Customer A can never retrieve or mutate Customer B's sites, checkpoints or geofences.",
  "properties": {
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reseller ID for reseller-scoped access"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "geofence_radius": {
      "type": "number",
      "default": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qr_code": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "default": "medium"
          },
          "description": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              }
            }
          }
        }
      },
      "default": []
    },
    "patrol_config": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_time": {
                "type": "string"
              },
              "end_time": {
                "type": "string"
              },
              "frequency_minutes": {
                "type": "number"
              },
              "days": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "random_timing": {
                "type": "boolean",
                "default": false,
                "description": "TRUE RANDOM PATROL TIMING: when true the generator produces unpredictable (but deterministic/idempotent per site+date) patrol times inside this schedule's operational window instead of fixed start_time + frequency_minutes intervals."
              },
              "patrol_count": {
                "type": "number",
                "description": "Number of patrols to generate inside the window when random_timing is on. Falls back to the frequency-derived count when unset."
              },
              "min_spacing_minutes": {
                "type": "number",
                "default": 45,
                "description": "Minimum spacing between randomly-timed patrols (enforced by construction of the generation slots)."
              }
            }
          },
          "default": []
        },
        "duration_target_minutes": {
          "type": "number",
          "default": 30
        },
        "random_route": {
          "type": "boolean",
          "default": true
        },
        "ai_route_optimization": {
          "type": "boolean",
          "default": true
        },
        "required_checkpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "alert_before_minutes": {
          "type": "number",
          "default": 10
        },
        "escalation_after_minutes": {
          "type": "number",
          "default": 15
        },
        "supervisor_escalation": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "checklist_templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_workflow": {
      "type": "string",
      "enum": [
        "default",
        "grid_gate_hospitality"
      ],
      "default": "default",
      "description": "Site-level access-control workflow selection, SEPARATE from customer branding and demo-data generation \u2014 never activated by a logo, app name, email domain or PWA slug, only by this explicit setting. 'default' = existing scan/vehicle/pedestrian/QR access-control flow (unchanged). 'grid_gate_hospitality' = the GRID GATE Hospitality custom entry workflow (ten documented categories: Check Ins, Contractors, Deliveries, Event or Function Visitor, Guests, Service Provider, Staff, Uber Eats / Mr D, Uber, Visitors), enforced server-side by the finalizeAccessEntry gateway's hospitality_submit action \u2014 a client-supplied workflow selection is never trusted; the gateway always re-resolves this field from the authorised site record. Managed through the siteAccess gateway only."
    },
    "access_workflow_version": {
      "type": "number",
      "default": 1,
      "description": "Snapshot number stamped onto every HospitalityVisit created while this workflow is active, so a later change to the site's workflow configuration never reinterprets historical visit records."
    }
  },
  "required": [
    "name",
    "address",
    "client_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}