{
  "name": "Venue",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "clubhouse",
        "pool",
        "gym",
        "tennis_court",
        "braai_area",
        "conference_room",
        "sports_field",
        "hall",
        "lounge",
        "other"
      ]
    },
    "capacity": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "booking_fee": {
      "type": "number",
      "default": 0
    },
    "deposit_required": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "maintenance"
      ],
      "default": "active"
    },
    "available_hours_start": {
      "type": "string"
    },
    "available_hours_end": {
      "type": "string"
    },
    "allows_multi_day": {
      "type": "boolean",
      "default": false,
      "description": "Whether this venue supports multi-day bookings"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manager_approval"
      ],
      "default": "automatic",
      "description": "Automatic approval or Estate Manager approval required"
    },
    "advance_booking_days": {
      "type": "number",
      "default": 90,
      "description": "Max days in advance a booking can be made"
    },
    "rules": {
      "type": "string"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "facility_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "question_type": {
            "type": "string",
            "enum": [
              "number",
              "text",
              "yes_no",
              "checkbox_acknowledgement",
              "dropdown",
              "multi_select"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Choices for dropdown/multi_select"
          },
          "acknowledgement_text": {
            "type": "string",
            "description": "Required acknowledgement text for checkbox_acknowledgement type"
          }
        }
      },
      "default": []
    },
    "blocked_periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_datetime": {
            "type": "string",
            "format": "date-time"
          },
          "end_datetime": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}