{
  "name": "PanicAlert",
  "type": "object",
  "description": "Emergency panic alert with a simple lifecycle: active \u2192 acknowledged \u2192 resolved (or cancelled). There is NO automatic escalation \u2014 a panic is submitted ONCE, the initial notification is sent immediately, and the Control Room Panic Queue provides visual urgency. initial_notification_sent_at is the durable marker that the single initial notification event occurred (audit + idempotency). The next_escalation_at / escalation_count / escalated fields are retained for historical data only and are no longer used by any active automation. Platform oversight: the built-in role 'admin' (USS Platform Admin) plus users with admin_level 'platform' / role_type 'platform_admin' may read/update/delete ANY panic across all tenants for emergency oversight. Tenant isolation for reseller/customer operational users is enforced via reseller_id/customer_id matching; the activator and the assigned responder can always access their own panic. CANCEL POLICY: accidental cancellation is ORIGINATOR-ONLY (managePanic enforces server-side) \u2014 only the original sender may cancel their own panic; responders may acknowledge/assign/resolve but never cancel someone else's panic.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "panic_number": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "badge_number": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "control_room_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "OPERATOR SCOPE RETENTION: for a panic triggered by a Control Room Operator, the SINGLE control room unambiguously assigned to the sender at activation time (null when the sender has zero or multiple active room assignments \u2014 ambiguity is never guessed). Together with site_id this defines which Control Room Operators may view/respond in the Panic Queue: an operator sees only panics attributable to one of her explicitly assigned rooms \u2014 via panic.site_id linked to one of her rooms' service-area sites, or via this field matching one of her assigned rooms. A panic with NEITHER valid site scope NOR valid control-room scope is NOT shown to customer operators at large \u2014 only to explicitly authorised configured responders / customer emergency oversight."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "assigned",
        "accepted",
        "resolved",
        "cancelled"
      ],
      "default": "active"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "critical"
    },
    "notes": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "gps_accuracy": {
      "type": "number"
    },
    "location_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "location_source": {
      "type": "string",
      "enum": [
        "cached",
        "fresh",
        "unavailable"
      ]
    },
    "location_updated": {
      "type": "boolean",
      "default": false
    },
    "acknowledged_by": {
      "type": "string"
    },
    "acknowledged_by_name": {
      "type": "string"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_by_name": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_by_name": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution_notes": {
      "type": "string"
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalation_count": {
      "type": "number",
      "default": 0,
      "description": "DEPRECATED \u2014 retained for historical data. No longer incremented by any active automation."
    },
    "next_escalation_at": {
      "type": "string",
      "format": "date-time",
      "description": "DEPRECATED \u2014 retained for historical data. Set to null on all new panics; no active automation reads it."
    },
    "notification_sent": {
      "type": "boolean",
      "default": false
    },
    "initial_notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the ONE-TIME initial panic notification was dispatched. There is NO automatic escalation or re-send; this field is the durable marker that the single initial notification event occurred (audit + idempotency)."
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "by_user_id": {
            "type": "string"
          },
          "by_user_name": {
            "type": "string"
          },
          "from_status": {
            "type": "string"
          },
          "to_status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "user_id",
    "user_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}