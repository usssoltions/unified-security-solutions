{
  "name": "Incident",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "fire",
        "theft",
        "vandalism",
        "medical",
        "trespassing",
        "suspicious_activity",
        "equipment_failure",
        "safety_hazard",
        "other"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "assigned",
        "accepted",
        "in_progress",
        "resolved",
        "closed",
        "declined",
        "reassigned"
      ],
      "default": "reported"
    },
    "incident_number": {
      "type": "string",
      "description": "Human-readable reference e.g. INC-1234567890"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "badge_number": {
      "type": "string",
      "description": "Reporting guard's badge/employee number"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "gps_accuracy": {
      "type": "number",
      "description": "GPS accuracy in metres at capture time"
    },
    "location_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "photo",
              "video",
              "audio"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "assigned_to": {
      "type": "string",
      "description": "User ID of assigned responder"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string",
      "description": "User ID of who assigned"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_by_name": {
      "type": "string"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_by": {
      "type": "string"
    },
    "declined_by_name": {
      "type": "string"
    },
    "decline_reason": {
      "type": "string"
    },
    "dispatcher_notes": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_by_name": {
      "type": "string"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "escalation_reason": {
      "type": "string",
      "enum": [
        "priority",
        "timeout",
        "manual"
      ]
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reassigned": {
      "type": "boolean",
      "default": false
    },
    "reassignment_reason": {
      "type": "string"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string",
            "description": "created, assigned, accepted, declined, resolved, closed, reassigned, escalated, updated"
          },
          "by_user_id": {
            "type": "string"
          },
          "by_user_name": {
            "type": "string"
          },
          "from_status": {
            "type": "string"
          },
          "to_status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "title",
    "category",
    "guard_id",
    "site_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}