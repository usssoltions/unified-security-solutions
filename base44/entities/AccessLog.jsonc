{
  "name": "AccessLog",
  "type": "object",
  "description": "Permanent audit record of every access entry, exit and denial. A single record represents the full entry\u2192exit lifecycle.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "entry",
        "exit",
        "denied"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "inside",
        "exited",
        "denied",
        "blacklisted",
        "override_approved",
        "overridden"
      ],
      "default": "inside"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "resident",
        "visitor",
        "guard",
        "vendor",
        "contractor",
        "unknown"
      ]
    },
    "person_id": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "person_phone": {
      "type": "string"
    },
    "visitor_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "gate_name": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "scan_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "sa_id",
        "drivers_licence",
        "vehicle_disc",
        "manual",
        "face"
      ]
    },
    "scanned_data": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "driver_licence_number": {
      "type": "string"
    },
    "sa_id_number": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "vehicle_licence_disc_number": {
      "type": "string"
    },
    "vehicle_vin": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_colour": {
      "type": "string"
    },
    "vehicle_licence_number": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "visit_or_work": {
      "type": "string",
      "enum": [
        "visit",
        "work",
        "none"
      ],
      "default": "none"
    },
    "work_type": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "visitor_type": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "parsed_json": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "device": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "entry_time": {
      "type": "string",
      "format": "date-time"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time"
    },
    "time_on_site_minutes": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "exit_gate": {
      "type": "string"
    },
    "exit_guard_id": {
      "type": "string"
    },
    "exit_guard_name": {
      "type": "string"
    },
    "exit_scan_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "sa_id",
        "drivers_licence",
        "vehicle_disc",
        "manual",
        "face"
      ]
    },
    "exit_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "exit_notes": {
      "type": "string"
    },
    "override_approved_by": {
      "type": "string"
    },
    "override_approved_by_name": {
      "type": "string"
    },
    "override_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "override_reason": {
      "type": "string"
    },
    "blacklist_match_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    },
    "flag_reason": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "status",
    "person_type",
    "gate_name",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "data.exit_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "data.exit_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}