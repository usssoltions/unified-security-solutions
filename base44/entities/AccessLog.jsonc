{
  "name": "AccessLog",
  "type": "object",
  "description": "Permanent, searchable audit record of every access entry, exit and denial. A single record represents the full entry\u2192exit lifecycle: it is created on entry with status 'inside' and UPDATED on exit (not duplicated).",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "entry",
        "exit",
        "denied"
      ],
      "description": "Latest event on this record. Entry records start as 'entry' and flip to 'exit' when the visitor leaves."
    },
    "status": {
      "type": "string",
      "enum": [
        "inside",
        "exited",
        "denied",
        "blacklisted",
        "override_approved",
        "overridden"
      ],
      "default": "inside",
      "description": "Lifecycle status. 'inside' = currently on site; 'exited' = has left; 'denied' = refused entry; 'blacklisted' = blocked by blacklist; 'override_approved'/'overridden' = supervisor overrode a block."
    },
    "person_type": {
      "type": "string",
      "enum": [
        "resident",
        "visitor",
        "guard",
        "vendor",
        "contractor",
        "unknown"
      ]
    },
    "person_id": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "visitor_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "gate_name": {
      "type": "string",
      "description": "Entry gate"
    },
    "site_name": {
      "type": "string"
    },
    "scan_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "sa_id",
        "drivers_licence",
        "vehicle_disc",
        "manual",
        "face"
      ]
    },
    "scanned_data": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "driver_licence_number": {
      "type": "string"
    },
    "sa_id_number": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "vehicle_licence_disc_number": {
      "type": "string"
    },
    "vehicle_vin": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_colour": {
      "type": "string"
    },
    "vehicle_licence_number": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "visit_or_work": {
      "type": "string",
      "enum": [
        "visit",
        "work",
        "none"
      ],
      "default": "none"
    },
    "work_type": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "visitor_type": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "parsed_json": {
      "type": "string",
      "description": "Verbatim barKoder formattedJSON for the entry scan"
    },
    "confidence": {
      "type": "number"
    },
    "device": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Entry GPS"
    },
    "entry_time": {
      "type": "string",
      "format": "date-time"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time"
    },
    "time_on_site_minutes": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Record creation time (= entry time)"
    },
    "guard_id": {
      "type": "string",
      "description": "Entry guard"
    },
    "guard_name": {
      "type": "string"
    },
    "exit_gate": {
      "type": "string",
      "description": "Gate used to exit"
    },
    "exit_guard_id": {
      "type": "string"
    },
    "exit_guard_name": {
      "type": "string"
    },
    "exit_scan_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "sa_id",
        "drivers_licence",
        "vehicle_disc",
        "manual",
        "face"
      ]
    },
    "exit_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "exit_notes": {
      "type": "string"
    },
    "override_approved_by": {
      "type": "string",
      "description": "Supervisor user id who overrode a block"
    },
    "override_approved_by_name": {
      "type": "string"
    },
    "override_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "override_reason": {
      "type": "string"
    },
    "blacklist_match_id": {
      "type": "string",
      "description": "BlacklistEntry id that matched, if any"
    },
    "notes": {
      "type": "string"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    },
    "flag_reason": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "status",
    "person_type",
    "gate_name",
    "timestamp"
  ]
}