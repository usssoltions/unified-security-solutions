{
  "name": "AccessLog",
  "type": "object",
  "description": "Permanent audit record of every access entry, exit and denial \u2014 THE authoritative visit record (one record = one full entry\u2192exit lifecycle; its id is the stable visit id). PERMANENT DUAL ATTRIBUTION: the ENTRY side permanently records WHO processed it (guard_id/guard_name), WHICH DEVICE (entry_device_registration_id/entry_device_name \u2014 resolved server-side from the caller's ACTIVE DeviceRegistration, never client-supplied), WHERE (site_id/site_name/gate_name), WHEN (entry_time) and HOW (scan_method); the EXIT side permanently and SEPARATELY records the same (exit_guard_id/exit_guard_name, exit_device_registration_id/exit_device_name, exit_gate, exit_time, exit_scan_method) \u2014 an exit NEVER overwrites the original entry attribution, and entry/exit may legitimately occur on DIFFERENT gates/devices. CONCURRENCY: exits are committed as conditional (CAS) status 'inside'\u2192'exited' updates, so two devices racing to exit the same visit cannot produce two exits (the loser receives 'already exited'). TENANT ISOLATION: reads/updates are customer-scoped; the reseller_id branch is reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every customer's access log to every other customer under the same reseller, including the active/on-site Live Access Log and the Exit action (confirmed live cross-customer defect 2026-09-21). Cross-tenant EXIT and the caller's registered-active-device requirement are additionally enforced server-side by the finalizeAccessEntry gateway before any mutation.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID for multi-tenant isolation"
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "entry",
        "exit",
        "denied"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "inside",
        "exited",
        "denied",
        "blacklisted",
        "override_approved",
        "overridden"
      ],
      "default": "inside"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "resident",
        "visitor",
        "guard",
        "vendor",
        "contractor",
        "unknown"
      ]
    },
    "person_id": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "person_phone": {
      "type": "string"
    },
    "visitor_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "gate_name": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "scan_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "sa_id",
        "drivers_licence",
        "vehicle_disc",
        "manual",
        "face"
      ]
    },
    "scanned_data": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "driver_licence_number": {
      "type": "string"
    },
    "sa_id_number": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "vehicle_licence_disc_number": {
      "type": "string"
    },
    "vehicle_vin": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_colour": {
      "type": "string"
    },
    "vehicle_licence_number": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "visit_or_work": {
      "type": "string",
      "enum": [
        "visit",
        "work",
        "none"
      ],
      "default": "none"
    },
    "work_type": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "visitor_type": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "parsed_json": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "device": {
      "type": "string",
      "description": "Legacy informational client device descriptor (user-agent snapshot). Attribution uses entry_device_registration_id/entry_device_name instead \u2014 resolved server-side from the active registered device."
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "entry_time": {
      "type": "string",
      "format": "date-time"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time"
    },
    "time_on_site_minutes": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "entry_device_registration_id": {
      "type": "string",
      "description": "DeviceRegistration id of the REGISTERED, ACTIVE device this ENTRY was processed from \u2014 resolved SERVER-SIDE from the caller's active device registration (deviceAccess/finalizeAccessEntry gateways), never client-supplied. Permanent attribution: which physical installation processed the entry."
    },
    "entry_device_name": {
      "type": "string",
      "description": "Operational name of the device that processed the ENTRY (snapshot of the DeviceRegistration's device_name at entry time, e.g. 'Gate 1 Scanner') \u2014 kept permanently even if the device is later renamed, deactivated or revoked."
    },
    "exit_gate": {
      "type": "string"
    },
    "exit_guard_id": {
      "type": "string"
    },
    "exit_guard_name": {
      "type": "string"
    },
    "exit_device_registration_id": {
      "type": "string",
      "description": "DeviceRegistration id of the REGISTERED, ACTIVE device this EXIT was processed from \u2014 resolved SERVER-SIDE. May legitimately differ from the entry device (cross-gate exit); never overwrites the entry attribution."
    },
    "exit_device_name": {
      "type": "string",
      "description": "Operational name of the device that processed the EXIT (snapshot at exit time, e.g. 'Gate 3 Scanner'). Permanent and separate from the entry device attribution."
    },
    "exit_scan_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "sa_id",
        "drivers_licence",
        "vehicle_disc",
        "manual",
        "face"
      ]
    },
    "exit_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "exit_notes": {
      "type": "string"
    },
    "override_approved_by": {
      "type": "string"
    },
    "override_approved_by_name": {
      "type": "string"
    },
    "override_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "override_reason": {
      "type": "string"
    },
    "blacklist_match_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    },
    "flag_reason": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "status",
    "person_type",
    "gate_name",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "data.exit_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        },
        {
          "data.guard_id": "{{user.id}}"
        },
        {
          "data.exit_guard_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}