{
  "name": "AccessLog",
  "type": "object",
  "description": "Permanent, searchable audit record of every access entry, exit and denial.",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "entry",
        "exit",
        "denied"
      ]
    },
    "person_type": {
      "type": "string",
      "enum": [
        "resident",
        "visitor",
        "guard",
        "vendor",
        "contractor",
        "unknown"
      ]
    },
    "person_id": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "visitor_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "gate_name": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "scan_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "sa_id",
        "drivers_licence",
        "vehicle_disc",
        "manual",
        "face"
      ]
    },
    "scanned_data": {
      "type": "string"
    },
    "qr_code": {
      "type": "string"
    },
    "driver_licence_number": {
      "type": "string"
    },
    "sa_id_number": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "vehicle_licence_disc_number": {
      "type": "string"
    },
    "vehicle_vin": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_colour": {
      "type": "string"
    },
    "vehicle_licence_number": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "visit_or_work": {
      "type": "string",
      "enum": [
        "visit",
        "work",
        "none"
      ],
      "default": "none"
    },
    "work_type": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "visitor_type": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "parsed_json": {
      "type": "string",
      "description": "Verbatim barKoder formattedJSON for the scan"
    },
    "confidence": {
      "type": "number"
    },
    "device": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "entry_time": {
      "type": "string",
      "format": "date-time"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time"
    },
    "time_on_site_minutes": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    },
    "flag_reason": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "person_type",
    "gate_name",
    "timestamp"
  ]
}