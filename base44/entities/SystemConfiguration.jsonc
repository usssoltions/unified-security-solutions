{
  "name": "SystemConfiguration",
  "type": "object",
  "description": "Persisted system configuration per customer/tenant. Stores configurable dropdown lists, category definitions, and module-specific settings as JSON blocks. Replaces local-state-only Configuration with database-backed persistence. VERIFIED (2026-09-21): consumed server-side via asServiceRole (getLinkusConfig) and by the platform-admin Configuration page. TENANT ISOLATION: the reseller_id branches are reserved for RESELLER ADMINISTRATORS only (admin_level 'reseller') \u2014 an ungated reseller branch exposes every sibling customer's configuration to every user under the same reseller (confirmed cross-customer defect class 2026-09-21). Customers read/write their OWN customer-scoped configuration only.",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant/customer ID. Null for platform-wide defaults."
    },
    "reseller_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string",
      "description": "Optional site-level override"
    },
    "config_key": {
      "type": "string",
      "description": "Configuration block key: incident_categories, maintenance_categories, alarm_types, asset_categories, access_settings, calling_config, etc."
    },
    "config_value": {
      "type": "string",
      "description": "JSON-encoded configuration value (array of objects, key-value map, etc.)"
    },
    "module_key": {
      "type": "string",
      "description": "Module this config belongs to: SECURITY, ESTATE, MEDICAL, PLATFORM, ACCESS, etc."
    },
    "updated_by": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "config_key",
    "config_value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.reseller_id": "{{user.data.reseller_id}}"
            },
            {
              "data.reseller_id": {
                "$ne": null
              }
            },
            {
              "user_condition": {
                "admin_level": "reseller"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}