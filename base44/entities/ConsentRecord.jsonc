{
  "name": "ConsentRecord",
  "type": "object",
  "description": "Medical module: Configurable consent/purpose records for POPIA compliance. The medicalAccess gateway grants practice-staff access (capture + read); employer users have ZERO access. GATEWAY-ONLY ACCESS: direct client access is restricted to platform administration (built-in role 'admin' and admin_level 'platform') by RLS. Deletion is not offered through the gateway (compliance preservation).",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "patient_processing",
        "employer_communication",
        "report_sharing",
        "photography",
        "identity_verification",
        "treatment_service"
      ],
      "default": "patient_processing"
    },
    "consent_text_version": {
      "type": "string"
    },
    "consent_text_hash": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "accepted",
        "refused",
        "withdrawn"
      ],
      "default": "accepted"
    },
    "captured_by_id": {
      "type": "string"
    },
    "captured_by_name": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_data": {
      "type": "string"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "patient_id",
    "consent_type",
    "result"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}