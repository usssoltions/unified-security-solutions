{
  "name": "ConsentRecord",
  "type": "object",
  "description": "Medical module: Configurable consent/purpose records for POPIA compliance.",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "patient_processing",
        "employer_communication",
        "report_sharing",
        "photography",
        "identity_verification",
        "treatment_service"
      ],
      "default": "patient_processing"
    },
    "consent_text_version": {
      "type": "string"
    },
    "consent_text_hash": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "accepted",
        "refused",
        "withdrawn"
      ],
      "default": "accepted"
    },
    "captured_by_id": {
      "type": "string"
    },
    "captured_by_name": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_data": {
      "type": "string"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "patient_id",
    "consent_type",
    "result"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "admin_level": "platform"
          }
        },
        {
          "$and": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "admin_level": "platform"
      }
    }
  }
}