{
  "name": "PatientIdentityVerification",
  "type": "object",
  "description": "Medical module: Identity verification record. Documents the document used, realtime photo, verification result, and verifier. Human-assisted identity verification \u2014 NOT biometric facial recognition. The medicalAccess gateway grants practice-staff access (reception/therapist/practice_admin capture and read; employers have ZERO access) and stamps the verifier identity server-side. GATEWAY-ONLY ACCESS: direct client access is restricted to platform administration (built-in role 'admin' and admin_level 'platform') by RLS. Deletion is not offered through the gateway (clinical preservation).",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "sa_id",
        "drivers_licence",
        "passport",
        "manual"
      ]
    },
    "document_scan_url": {
      "type": "string",
      "description": "Scanned document photo"
    },
    "document_photo_url": {
      "type": "string",
      "description": "Photo extracted from the scanned document"
    },
    "realtime_photo_url": {
      "type": "string",
      "description": "Realtime person photo captured during verification"
    },
    "result": {
      "type": "string",
      "enum": [
        "verified",
        "failed",
        "manual_review"
      ],
      "default": "manual_review"
    },
    "failure_reason": {
      "type": "string"
    },
    "verifier_id": {
      "type": "string"
    },
    "verifier_name": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "location_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "scan_data": {
      "type": "string",
      "description": "Parsed scan data summary (not full raw barcode)"
    }
  },
  "required": [
    "customer_id",
    "patient_id",
    "result"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "admin_level": "platform"
          }
        }
      ]
    }
  }
}